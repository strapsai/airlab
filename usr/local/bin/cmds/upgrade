#!/bin/bash
# airlab upgrade — self-upgrade the airlab tool to the latest version from GitHub.
#
# Flow: download the current source from GitHub (the repo recorded in
# /usr/share/airlab/install_source, default strapsai/airlab) to /tmp, remove the
# installed package (dpkg -r airlab), and reinstall by running the freshly
# downloaded install.sh. install.sh is run INTERACTIVELY — you answer its venv and
# sudo prompts at the keyboard.
#
# Self-deletion safety: `airlab upgrade` is itself a file inside the airlab package,
# so it cannot run `dpkg -r airlab` from its own script without risking the file
# being pulled out from under bash. Instead it downloads the fresh source to /tmp
# and `exec`s a runner from /tmp; after the exec, this process runs entirely from
# /tmp, independent of the package about to be removed. `exec` keeps the controlling
# terminal, so install.sh (and sudo) stay fully interactive.

set -uo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'
log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

show_usage() {
    cat <<EOF
Usage: airlab upgrade [--branch <branch>] [--yes] [-- <install.sh flags>...]

Upgrade the airlab tool: download the latest source from GitHub, remove the
installed package, and reinstall by running install.sh interactively.

Options:
  --branch <branch>   Branch to install from (default: main).
  -y, --yes           Skip the confirmation prompt.
  -- <flags>...       Pass the remaining args through to install.sh (e.g. --offline).
  -h, --help          Show this help.
EOF
}

branch="main"
assume_yes=false
install_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --branch)   branch="${2:?--branch needs a value}"; shift 2 ;;
        --branch=*) branch="${1#*=}"; shift ;;
        -y|--yes)   assume_yes=true; shift ;;
        -h|--help)  show_usage; exit 0 ;;
        --)         shift; install_args=("$@"); break ;;
        *)          log_error "Unknown option: $1"; show_usage; exit 1 ;;
    esac
done

for tool in curl unzip; do
    command -v "$tool" >/dev/null 2>&1 || { log_error "'$tool' is required but not installed."; exit 1; }
done

# Fork-aware source, same as robot-setup: the repo is recorded at .deb-build time.
source_repo="$(cat /usr/share/airlab/install_source 2>/dev/null || echo "strapsai/airlab")"
source_url="https://github.com/${source_repo}/archive/refs/heads/${branch}.zip"
current_version="$(dpkg-query --show --showformat='${Version}' airlab 2>/dev/null || echo 'unknown')"

log_info "airlab upgrade"
echo "  source  : ${source_repo} @ ${branch}"
echo "  current : v${current_version}"
echo "  action  : remove the installed package, then run install.sh interactively"

if [ "$assume_yes" != true ]; then
    read -r -p "Proceed? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_warn "Aborted."; exit 0; }
fi

# Download fresh source to /tmp — this does NOT touch the installed package.
work="/tmp/airlab-upgrade"
rm -rf "$work"; mkdir -p "$work"
log_info "Downloading ${source_url} ..."
curl -fL -o "${work}/airlab.zip" "$source_url" || { log_error "Download failed — check --branch (${branch})."; exit 1; }
unzip -q -o "${work}/airlab.zip" -d "$work"    || { log_error "Unzip failed."; exit 1; }
# GitHub's archive extracts to a single top-level dir. Its name is the ref with
# '/' replaced by '-' (so a branch like ai/vektor/foo -> airlab-ai-vektor-foo);
# detect it rather than guessing, which is fragile for slashed branch names.
src="$(find "$work" -mindepth 1 -maxdepth 1 -type d -print -quit)"
[ -n "$src" ] && [ -f "${src}/install.sh" ] || { log_error "install.sh not found in the downloaded source under ${work} — check --branch (${branch})."; exit 1; }
chmod -R a+x "$src"

# Write the remove+reinstall runner INTO /tmp and hand off with exec. Once exec'd,
# nothing we run lives inside the airlab package, so `dpkg -r airlab` is safe; the
# controlling terminal is preserved, so install.sh prompts interactively.
runner="${work}/run-upgrade.sh"
cat > "$runner" <<RUNNER
#!/bin/bash
set -uo pipefail
echo "[INFO] Removing the installed airlab package (sudo) ..."
sudo dpkg -r airlab || echo "[WARN] 'dpkg -r airlab' failed (proceeding to reinstall anyway)."
echo "[INFO] Reinstalling via install.sh (interactive) ..."
cd "${src}"
bash "${src}/install.sh" ${install_args[*]}
status=\$?
echo ""
if [ "\$status" -eq 0 ]; then
    echo "[INFO] Done. Now: \$(airlab --version 2>/dev/null || echo 'airlab --version unavailable')"
else
    echo "[ERROR] install.sh exited \$status. airlab may be left uninstalled — re-run: bash ${src}/install.sh" >&2
fi
exit \$status
RUNNER
chmod +x "$runner"

log_info "Handing off to the upgrade runner in /tmp ..."
exec bash "$runner"
