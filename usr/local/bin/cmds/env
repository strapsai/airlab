#!/bin/bash
#
# airlab env — inspect and synchronise environment variables.
#
# Two stores hold a machine's environment:
#   - `<AIRLAB_PATH>/airlab.env` ON the machine — what it actually uses.
#   - `<AIRLAB_PATH>/robot/robot_info.yaml` HERE, on the operator's workstation —
#     the git-tracked record of what it should be.
#
# `compare` reports drift between them and `sync-from` / `sync-to` close it. The
# registry side is ALWAYS the local one: `airlab env compare g-uav-2` reads this
# machine's robot_info.yaml and the robot's airlab.env, so the comparison is
# meaningful from wherever you happen to be driving the fleet.
#
# The env file is read as TEXT and never sourced, so shell literals a machine
# legitimately stores (`USER_NAME=${SUDO_USER:-$USER}`, `GROUP_NAME=$(id -gn)`)
# survive a round trip instead of collapsing into whatever they expand to here.

# Shared SSH-address resolution (--address via robots.yaml)
source "$(dirname "$0")/_lib/resolve.sh"
# Shared robot_info.yaml access
source "$(dirname "$0")/_lib/robot_info.sh"
# Safe KEY=VALUE editing of airlab.env
source "$(dirname "$0")/_lib/env_file.sh"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
error_exit() { log_error "$1"; exit 1; }

ROBOT_INFO_PY="$(dirname "$0")/_lib/robot_info.py"

show_usage() {
    cat <<EOF
$(echo -e "${YELLOW}Usage:${NC}") airlab env <subcommand> [target] [options]

$(echo -e "${YELLOW}Subcommands:${NC}")
  show <local|system>       Print the airlab.env of this machine or a remote one
  compare <system>          Diff the LOCAL robot_info.yaml record against the
                            remote machine's live airlab.env
  sync-from <system>        Update the local robot_info.yaml from the remote airlab.env
  sync-to <system>          Update the remote airlab.env from the local robot_info.yaml
  set <local|system> VAR=value
                            Set one variable (on the machine, and in the record
                            when the target is a system)

$(echo -e "${YELLOW}Options:${NC}")
  --address=<name>          Named network address from robots.yaml (e.g. internet, vpn)
  --password                Skip key-based SSH and prompt for a password
  --prune                   sync-from/sync-to: also REMOVE keys the source lacks
                            (default is a merge, which only adds and updates)
  --dry-run                 sync-from/sync-to: report what would change, write nothing
  -y, --yes                 Do not prompt for confirmation
  -h, --help                Show this help message

$(echo -e "${YELLOW}Examples:${NC}")
  airlab env show local
  airlab env show g-uav-2 --address=vpn
  airlab env compare g-uav-2               # what has drifted on the robot?
  airlab env sync-from g-uav-2             # adopt the robot's env into the record
  airlab env sync-to g-uav-2 --dry-run     # what would pushing the record change?
  airlab env set local ROS_DOMAIN_ID=10
  airlab env set g-uav-2 ROS_DOMAIN_ID=10

$(echo -e "${YELLOW}Exit status:${NC}")
  compare returns 0 when the two sides agree and 2 when they have drifted, so it
  can gate a script; 1 means the comparison could not be made.
EOF
}

# --- SSH plumbing (same pattern as the other commands) --------------------- #

ssh_authenticate() {
    local ssh_address=$1
    local force_password=${2:-false}
    robot_password=""

    if [[ "$force_password" == false ]]; then
        if ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=no -o BatchMode=yes \
               -p "${SSH_PORT:-22}" "$ssh_address" exit 2>/dev/null; then
            return 0
        fi
        log_warn "Key-based SSH failed. Falling back to password authentication."
    fi

    if ! command -v sshpass >/dev/null 2>&1; then
        log_error "Key-based SSH failed and 'sshpass' is not installed for password fallback."
        return 1
    fi

    log_info "Enter password for $ssh_address:"
    read -rs robot_password
    echo
    [[ -z "$robot_password" ]] && { log_error "Password cannot be empty"; return 1; }

    if ! sshpass -p "$robot_password" ssh -o ConnectTimeout=15 \
            -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$ssh_address" exit; then
        log_error "Cannot connect to '$ssh_address'"
        return 1
    fi
    return 0
}

# Resolve a system to REMOTE_SSH / SSH_PORT / REMOTE_ENV, authenticating on the way.
# Sets SSHPASS_PREFIX for the caller.
resolve_remote() {
    local system="$1" address="$2" force_password="$3"

    REMOTE_SSH=$(resolve_ssh_address "$system" "$address")
    [[ -z "$REMOTE_SSH" ]] && error_exit \
        "System '$system'${address:+ (address '$address')} not found in robots.yaml"

    SSH_PORT=22
    REMOTE_SSH="${REMOTE_SSH#ssh://}"
    if [[ "$REMOTE_SSH" == *:* ]]; then
        SSH_PORT="${REMOTE_SSH##*:}"; REMOTE_SSH="${REMOTE_SSH%:*}"
    fi

    robot_password=""
    ssh_authenticate "$REMOTE_SSH" "$force_password" || exit 1
    SSHPASS_PREFIX=()
    [[ -n "$robot_password" ]] && SSHPASS_PREFIX=(sshpass -p "$robot_password")

    # The machine's workspace root comes from the record. A system that is in
    # robots.yaml but not yet in robot_info.yaml (a freshly registered machine)
    # falls back to the documented default rather than failing outright.
    local ws_path
    if ws_path="$(robot_info_get "$LOCAL_ROBOT_INFO" "$system" ws_path)" && [[ -n "$ws_path" ]]; then
        :
    else
        ws_path="\$HOME/airlab_ws"
        log_warn "No ws_path recorded for '$system'; assuming \$HOME/airlab_ws on the machine."
    fi
    REMOTE_ENV="$ws_path/airlab.env"
}

remote_ssh() { "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$@"; }

# Copy the remote airlab.env into a local file.
fetch_remote_env() {
    local dest="$1"
    if ! remote_ssh "$REMOTE_SSH" "cat \"$REMOTE_ENV\"" > "$dest" 2>/dev/null; then
        error_exit "Could not read $REMOTE_ENV on $REMOTE_SSH"
    fi
}

# Replace the remote airlab.env with a local file's contents.
#
# The content goes over STDIN, never inside the remote command string: it is
# arbitrary text containing quotes and `$`, and interpolating it would both corrupt
# the file and hand the remote shell whatever it happened to contain.
push_remote_env() {
    local src="$1"
    local remote_tmp="$REMOTE_ENV.airlab-tmp.$$"
    if ! remote_ssh "$REMOTE_SSH" \
            "cat > \"$remote_tmp\" && mv \"$remote_tmp\" \"$REMOTE_ENV\"" < "$src"; then
        remote_ssh "$REMOTE_SSH" "rm -f \"$remote_tmp\"" >/dev/null 2>&1
        error_exit "Could not write $REMOTE_ENV on $REMOTE_SSH"
    fi
}

confirm() {
    local prompt="$1"
    [ "$ASSUME_YES" = true ] && return 0
    local reply
    read -rp "$prompt (y/N): " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

# --- subcommands ------------------------------------------------------------ #

cmd_show() {
    local target="$1"
    if [[ "$target" == "local" ]]; then
        local env_file="$AIRLAB_PATH/airlab.env"
        [[ -f "$env_file" ]] || error_exit "No airlab.env at $env_file"
        log_info "$env_file (local)"
        cat "$env_file"
        return 0
    fi

    resolve_remote "$target" "$ADDRESS" "$FORCE_PASSWORD"
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    fetch_remote_env "$tmp"
    log_info "$REMOTE_ENV on $REMOTE_SSH"
    cat "$tmp"
}

cmd_compare() {
    local system="$1"
    [[ "$system" == "local" ]] && error_exit \
        "compare needs a system name: it diffs the local record against a machine's live airlab.env"

    resolve_remote "$system" "$ADDRESS" "$FORCE_PASSWORD"
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    fetch_remote_env "$tmp"

    python3 "$ROBOT_INFO_PY" envdiff "$LOCAL_ROBOT_INFO" "$system" "$tmp" \
        "$LOCAL_ROBOT_INFO" "$REMOTE_SSH:$REMOTE_ENV"
    return $?
}

cmd_sync_from() {
    local system="$1"
    [[ "$system" == "local" ]] && error_exit "sync-from needs a system name"

    resolve_remote "$system" "$ADDRESS" "$FORCE_PASSWORD"
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    fetch_remote_env "$tmp"

    log_info "Planned change to $LOCAL_ROBOT_INFO (system '$system'), from $REMOTE_SSH:$REMOTE_ENV:"
    local plan
    plan="$(python3 "$ROBOT_INFO_PY" import "$LOCAL_ROBOT_INFO" "$system" "$tmp" \
            ${PRUNE:+--prune} --dry-run)" || error_exit "Could not plan the import"
    echo "$plan"

    if [ "$DRY_RUN" = true ]; then
        log_info "--dry-run: nothing written."
        return 0
    fi
    if [[ "$plan" == "no changes" ]]; then
        log_info "Already in sync; nothing to write."
        return 0
    fi
    confirm "Apply to $LOCAL_ROBOT_INFO?" || { log_warn "Aborted."; return 1; }

    python3 "$ROBOT_INFO_PY" import "$LOCAL_ROBOT_INFO" "$system" "$tmp" \
        ${PRUNE:+--prune} >/dev/null || error_exit "Import failed"
    log_info "Updated $LOCAL_ROBOT_INFO for '$system'."
    log_warn "robot_info.yaml is git-tracked — review and commit the change."
}

cmd_sync_to() {
    local system="$1"
    [[ "$system" == "local" ]] && error_exit "sync-to needs a system name"

    resolve_remote "$system" "$ADDRESS" "$FORCE_PASSWORD"

    local current merged; current="$(mktemp)"; merged="$(mktemp)"
    trap 'rm -f "$current" "$merged"' RETURN
    fetch_remote_env "$current"

    # Start from the machine's own file so keys the record doesn't know about
    # survive, then lay the record's values over it. --prune starts from empty.
    if [ -n "$PRUNE" ]; then
        : > "$merged"
    else
        cp "$current" "$merged"
    fi
    local key value line
    while IFS= read -r line; do
        key="${line%%=*}"; value="${line#*=}"
        env_file_set "$merged" "$key" "$value" \
            || error_exit "Could not stage $key"
    done < <(python3 "$ROBOT_INFO_PY" env "$LOCAL_ROBOT_INFO" "$system")

    if diff -q "$current" "$merged" >/dev/null 2>&1; then
        log_info "$REMOTE_SSH:$REMOTE_ENV already matches the record; nothing to do."
        return 0
    fi

    log_info "Planned change to $REMOTE_SSH:$REMOTE_ENV:"
    diff -u --label "remote (current)" --label "record (proposed)" "$current" "$merged"

    if [ "$DRY_RUN" = true ]; then
        log_info "--dry-run: nothing written."
        return 0
    fi
    confirm "Overwrite $REMOTE_ENV on $REMOTE_SSH?" || { log_warn "Aborted."; return 1; }

    push_remote_env "$merged"
    log_info "Updated $REMOTE_ENV on $REMOTE_SSH."
    log_warn "Already-running shells and containers keep the old values until restarted."
}

cmd_set() {
    local target="$1" assignment="$2"
    [[ -z "$assignment" ]] && error_exit "set needs VAR=value"
    [[ "$assignment" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] \
        || error_exit "Invalid format '$assignment'. Use VAR=value"

    local var="${assignment%%=*}" value
    value="$(strip_paired_quotes "${assignment#*=}")"

    if [[ "$target" == "local" ]]; then
        local env_file="$AIRLAB_PATH/airlab.env"
        [[ -f "$env_file" ]] || { log_info "Creating $env_file"; : > "$env_file"; }
        env_file_set "$env_file" "$var" "$value" || error_exit "Failed to write $var"
        log_info "Set $var in $env_file"
        return 0
    fi

    resolve_remote "$target" "$ADDRESS" "$FORCE_PASSWORD"
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    fetch_remote_env "$tmp"
    env_file_set "$tmp" "$var" "$value" || error_exit "Failed to stage $var"
    push_remote_env "$tmp"
    log_info "Set $var in $REMOTE_ENV on $REMOTE_SSH"

    # Keep the operator-side record in step, as `set_env` did.
    update_robot_info "$AIRLAB_PATH" "$target" "$var" "$value"
}

# --- main ------------------------------------------------------------------- #

main() {
    if [[ $# -eq 0 ]]; then show_usage; exit 1; fi
    case "$1" in -h|--help|help) show_usage; exit 0 ;; esac

    local subcommand="$1"; shift

    ADDRESS=""
    FORCE_PASSWORD=false
    ASSUME_YES=false
    DRY_RUN=false
    PRUNE=""

    local positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --address)   ADDRESS="$2"; shift ;;
            --address=*) ADDRESS="${1#--address=}" ;;
            --password)  FORCE_PASSWORD=true ;;
            --prune)     PRUNE="--prune" ;;
            --dry-run)   DRY_RUN=true ;;
            -y|--yes)    ASSUME_YES=true ;;
            -h|--help)   show_usage; exit 0 ;;
            -*)          show_usage; error_exit "Unknown option: $1" ;;
            *)           positional+=("$1") ;;
        esac
        shift
    done

    [[ -z "${AIRLAB_PATH:-}" ]] && error_exit "AIRLAB_PATH is not set. Run 'sudo airlab setup local' first."
    LOCAL_ROBOT_INFO="$AIRLAB_PATH/robot/robot_info.yaml"

    local target="${positional[0]:-}"
    [[ -z "$target" ]] && { show_usage; error_exit "$subcommand needs a target"; }

    case "$subcommand" in
        show)      cmd_show "$target" ;;
        compare)   cmd_compare "$target" ;;
        sync-from) cmd_sync_from "$target" ;;
        sync-to)   cmd_sync_to "$target" ;;
        set)       cmd_set "$target" "${positional[1]:-}" ;;
        *)         show_usage; error_exit "Unknown subcommand: $subcommand" ;;
    esac
}

main "$@"
