#!/bin/bash
#
# Deprecated: `airlab set_hosts <target>` is now `airlab hosts set <target>`.
#
# Kept as a forwarding shim rather than deleted: the old name is in scripts, in
# ansible roles and in muscle memory, and `hosts set` is a strict superset of what
# it did. It forwards verbatim, so existing invocations keep working unchanged.
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

echo -e "${YELLOW}[WARN]${NC} 'airlab set_hosts' is deprecated — use 'airlab hosts set'." >&2
echo -e "${YELLOW}[WARN]${NC} See 'airlab hosts --help' for compare and remove too." >&2

exec "$(dirname "$0")/hosts" set "$@"
