#!/bin/bash

# Constants

USER_HOME=$(getent passwd $SUDO_USER | cut -d: -f6)
readonly ENV_FILE="/etc/airlab/airlab.env"
readonly DEFAULT_AIRLAB_PATH="$USER_HOME/airlab_ws"

# Shared SSH-address resolution (--address via robots.yaml, robot.conf fallback)
source "$(dirname "$0")/_lib/resolve.sh"

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Function to display usage
show_usage() {
    echo -e "${YELLOW}Usage:${NC}"
    echo "  airlab setup Command [options]"
    echo
    echo -e "${YELLOW}Commands:${NC}"
    echo "  local                   Setup local environment"
    echo "  <system_name>           Setup remote robot environment"
    echo
    echo -e "${YELLOW}Options:${NC}"
    echo "  --path=<path>           Custom installation path (default: $DEFAULT_AIRLAB_PATH)"
    echo "  --address=<name>        Use a named network address from robots.yaml (e.g. internet, vpn)"
    echo "  --force                 Force overwrite without prompting (use with caution)"
    echo "  --password              Skip key-based SSH and prompt for password directly"
    echo "  --airlab-src=<dir>      Install the airlab tool from a LOCAL source tree instead of"
    echo "                          downloading it from GitHub (required with --offline)"
    echo "  --offline               No-network remote install: use --airlab-src for the tool,"
    echo "                          rsync the airlab_ws repo content from the local working tree"
    echo "                          (no git clone), and run the remote install.sh --offline"
    echo "                          (skips apt/pip, reuses the existing venv)"
    echo "  -y, --non-interactive   Answer all prompts non-interactively (proceed/yes)"
    echo "  --keep-env              Preserve the robot's existing airlab.env and the local"
    echo "                          robot_info.yaml (in-field re-provisioning). Implied by --offline."
    echo "  --no-reboot             Do not prompt for / perform the post-setup reboot"
    echo
    echo -e "${YELLOW}Examples:${NC}"
    echo "  airlab setup local --path=/custom/path"
    echo "  airlab setup robot1 --path=~/custom/path --force"
    echo "  # In-field offline re-provisioning from a local backup of the airlab tool:"
    echo "  airlab setup robot1 --offline --airlab-src=/home/dtc/Documents/yaoyu/airlab \\"
    echo "      --force -y --keep-env --no-reboot"
}


# Function to handle errors
error_exit() {
    log_error "$1"
    exit 1
}

error_warn() {
    log_warn "$1"  # Assuming you have a log_warn function for logging warnings
    return 0       # Continue execution without exiting
}


# Function to parse command line arguments. Sets PARSED_* globals (rather than
# echoing a space-joined string) so a path-bearing --airlab-src is safe.
parse_args() {
    PARSED_PATH="$DEFAULT_AIRLAB_PATH"
    PARSED_FORCE=false
    PARSED_PASSWORD=false
    PARSED_ADDRESS=""
    PARSED_AIRLAB_SRC=""
    PARSED_OFFLINE=false
    PARSED_YES=false
    PARSED_KEEP_ENV=false
    PARSED_NO_REBOOT=false

    for arg in "$@"; do
        case "$arg" in
            --path=*)
                PARSED_PATH="${arg#--path=}"
                ;;
            --address=*)
                PARSED_ADDRESS="${arg#--address=}"
                ;;
            --airlab-src=*)
                PARSED_AIRLAB_SRC="${arg#--airlab-src=}"
                ;;
            --force)
                PARSED_FORCE=true
                ;;
            --password)
                PARSED_PASSWORD=true
                ;;
            --offline)
                PARSED_OFFLINE=true
                ;;
            -y|--non-interactive)
                PARSED_YES=true
                ;;
            --keep-env)
                PARSED_KEEP_ENV=true
                ;;
            --no-reboot)
                PARSED_NO_REBOOT=true
                ;;
            *)
                if [[ "$arg" != "local" && "$arg" != -* ]]; then
                    show_usage
                    error_exit "Invalid argument: $arg"
                fi
                ;;
        esac
    done

    # --offline implies no-network sourcing + state preservation. Require a local
    # tool source, since the GitHub download is unavailable offline.
    if [ "$PARSED_OFFLINE" = true ]; then
        PARSED_KEEP_ENV=true
        [[ -z "$PARSED_AIRLAB_SRC" ]] && error_exit "--offline requires --airlab-src=<dir> (the local airlab tool source)"
    fi
    if [[ -n "$PARSED_AIRLAB_SRC" && ! -d "$PARSED_AIRLAB_SRC" ]]; then
        error_exit "--airlab-src directory not found: $PARSED_AIRLAB_SRC"
    fi
}

# Environment management functions
load_env() {
    if [ -f "$ENV_FILE" ]; then
        source "$ENV_FILE"
    else
        AIRLAB_PATH="$DEFAULT_AIRLAB_PATH"
    fi
}

save_env() {
    local path="$1"
    log_info "Saving environment configuration..."
    
    sudo mkdir -p "$(dirname "$ENV_FILE")" || error_exit "Failed to create environment directory"
    echo "AIRLAB_PATH=\"$path\"" | sudo tee "$ENV_FILE" > /dev/null || error_exit "Failed to save environment file"
    
    log_info "Environment configuration saved to $ENV_FILE"
}


setup_bashrc() {
    local env_path="$1"
    local env_source="set -o allexport; source $env_path/airlab.env; set +o allexport"

    # .bashrc (always)
    local bashrc="$USER_HOME/.bashrc"
    if ! grep -q "source $env_path/airlab.env" "$bashrc" 2>/dev/null; then
        echo "$env_source" >> "$bashrc" || error_exit "Failed to update .bashrc"
        log_info "Updated .bashrc with environment configuration"
    else
        log_info ".bashrc already configured"
    fi

    # .zshrc (zsh users: a default-zsh login shell, or an existing .zshrc)
    local login_shell zshrc="$USER_HOME/.zshrc"
    login_shell=$(getent passwd "${SUDO_USER:-$USER}" 2>/dev/null | cut -d: -f7)
    if command -v zsh >/dev/null 2>&1 && { [ -f "$zshrc" ] || [ "$(basename "${login_shell:-}")" = "zsh" ]; }; then
        touch "$zshrc"
        if ! grep -q "source $env_path/airlab.env" "$zshrc" 2>/dev/null; then
            echo "$env_source" >> "$zshrc"
            log_info "Updated .zshrc with environment configuration"
        fi
    fi
}

cleanup_local() {
    local path="$1"
    log_info "Cleaning up existing installation..."
    rm -rf "$path" || error_exit "Failed to remove existing directory"
}
# Helper function to print completion message
print_completion_message() {
    local airlab_path="$1"
    local system="$2"
    log_info "✅ Local setup completed successfully"

    cat <<EOF

Installation details:
  - Path: $airlab_path
  - System: $system
  - Environment: $airlab_path/airlab.env

Note: Run 'source ~/.bashrc' to apply changes.
EOF

    log_info "Reminder: Update /etc/hosts with this system's IP address."
}

setup_local() {
    set -e  # Exit immediately if a command exits with a non-zero status

    local airlab_path="$1"
    local force="$2"
    local home_dir="$HOME"

    airlab_path="${airlab_path/#\~/$home_dir}"

    log_info "Initializing local setup at: $airlab_path"

    # Handle existing directory
    if [ -d "$airlab_path" ]; then
        if [ "$force" = true ]; then
            log_warn "Force flag is set. Cleaning up existing installation..."
            cleanup_local "$airlab_path"
        else
            log_warn "Directory $airlab_path already exists."
            read -p "Overwrite existing directory? (y/N): " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                log_info "Cleaning up existing installation..."
                cleanup_local "$airlab_path"
            else
                log_info "Skipping overwrite. Updating environment setup..."
                local env_file="$airlab_path/airlab.env"
                if [ -f "$env_file" ]; then
                    local current_user="${SUDO_USER:-$USER}"
                    local current_uid="$(id -u "$current_user")"
                    local current_gid="$(id -g "$current_user")"
                    local current_group="$(id -gn "$current_user")"

                    log_info "Updating environment file to reflect the current user and paths..."

                    # Update variables in the environment file
                    sed -i "s|^USER_NAME=.*|USER_NAME=$current_user|g" "$env_file"
                    sed -i "s|^USER=.*|USER=$current_user|g" "$env_file"
                    sed -i "s|^GROUP_NAME=.*|GROUP_NAME=$current_group|g" "$env_file"
                    sed -i "s|^USER_ID=.*|USER_ID=$current_uid|g" "$env_file"
                    sed -i "s|^GROUP_ID=.*|GROUP_ID=$current_gid|g" "$env_file"
                    sed -i "s|^AIRLAB_PATH=.*|AIRLAB_PATH=$airlab_path|g" "$env_file"

                    log_info "Environment file updated successfully."
                else
                    log_error "Environment file $env_file not found. Manual setup may be required."
                fi
                sed -i '/source .*airlab.env/d' "$HOME/.bashrc"
                setup_bashrc "$airlab_path"
                print_completion_message "$airlab_path" "local"
                exit 0
            fi
        fi
    fi

    # Create and configure new installation
    log_info "Setting up fresh installation at $airlab_path..."
    mkdir -p "$airlab_path" || error_exit "Failed to create directory: $airlab_path"

    log_info "Copying default configuration..."
    rsync -av --ignore-existing /etc/airlab/ "$airlab_path" || error_exit "Configuration copy failed"

    log_info "Creating initial environment file..."
    local docker_build=$airlab_path/docker/docker-compose.yml
    local docker_up=$airlab_path/docker/docker-compose.yml
    local launch_path=$airlab_path/launch/sample.yaml
    log_info "Updating robot configuration..."

    cat > "$airlab_path/airlab.env" <<EOF
AIRLAB_PATH=$airlab_path
AIRLAB_SYSTEM=local
ROBOT_NAME=local
USER_NAME=\${SUDO_USER:-\$USER}
USER=\${SUDO_USER:-\$USER}
GROUP_NAME=\${SUDO_USER:-\$(id -gn)}
GROUP_ID=\${SUDO_GID:-\$(id -g)}
USER_ID=\${SUDO_UID:-\$(id -u)}
DOCKER_BUILD_PATH=$docker_build
DOCKER_UP_PATH=$docker_up
LAUNCH_FILE_PATH=$launch_path
EOF
    sed -i '/source .*airlab.env/d' "$HOME/.bashrc"
    setup_bashrc "$airlab_path"

    print_completion_message "$airlab_path" "local"
}

update_robot_info() {
    local robot_info_file="$1"
    local robot_name="$2"
    local field="$3"
    local value="$4"
    local no_overwrite="$5"
    local return_var="$6"

    ROBOT_INFO_FILE="$robot_info_file/robot/robot_info.yaml"
    
    # Create YAML file if it doesn't exist
    if [ ! -f "$ROBOT_INFO_FILE" ]; then
        echo "robots:" > "$ROBOT_INFO_FILE"
    fi
    
    # Get current timestamp
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    # Retrieve existing value from YAML, if any
    local existing_value
    existing_value=$(sed -n "/^  $robot_name:/,/^  [^[:space:]]/p" "$ROBOT_INFO_FILE" | grep "^    $field:" | sed "s/^    $field: \"\(.*\)\"/\1/")

    if [ "$no_overwrite" = "--no-overwrite" ] && [ -n "$existing_value" ]; then
        value="$existing_value"
    fi
    
    # Check if robot already exists in YAML
    if grep -q "^  $robot_name:" "$ROBOT_INFO_FILE"; then
        # Check if field exists for this robot
        if grep -q "^    $field:" <(sed -n "/^  $robot_name:/,/^  [^[:space:]]/p" "$ROBOT_INFO_FILE"); then
            # Update existing field
            if [ "$no_overwrite" = "--no-overwrite" ]; then
                log_warn "Skipped updating $robot_name $field as --no-overwrite is set"
            else
                # Update existing field
                sed -i "/^  $robot_name:/,/^  [^[:space:]]/ {
                    s|^    $field:.*|    $field: \"$value\"|
                }" "$ROBOT_INFO_FILE"
            fi
        else
            # Add new field to existing robot
            sed -i "/^  $robot_name:/a\    $field: \"$value\"" "$ROBOT_INFO_FILE"
        fi
        # Always update last_updated timestamp
        sed -i "/^  $robot_name:/,/^  [^[:space:]]/ {
            s|^    last_updated:.*|    last_updated: \"$timestamp\"|
        }" "$ROBOT_INFO_FILE"
    else
        # Add new robot entry with the field
        cat >> "$ROBOT_INFO_FILE" << EOF
  $robot_name:
    $field: "$value"
    last_updated: "$timestamp"
EOF
    fi

    # Update the caller's variable
    if [ -n "$return_var" ]; then
        eval "$return_var=\"$value\""
    fi
    log_info "Updated robot $robot_name $field in $ROBOT_INFO_FILE"
}

ssh_authenticate() {
    local ssh_address=$1
    local force_password=${2:-false}
    robot_password=""

    if [[ "$force_password" == false ]]; then
        log_info "Attempting key-based SSH to $ssh_address..."
        if ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=no -o BatchMode=yes -p "${SSH_PORT:-22}" "$ssh_address" exit 2>/dev/null; then
            log_info "Key-based SSH connection successful"
            return 0
        fi
        log_warn "Key-based SSH failed. Falling back to password authentication."
    fi

    if ! command -v sshpass >/dev/null 2>&1; then
        log_error "Key-based SSH failed and 'sshpass' is not installed for password fallback."
        log_error "Either set up SSH keys or install sshpass: sudo apt install sshpass"
        return 1
    fi

    log_info "Enter password for $ssh_address:"
    read -s robot_password
    [[ -z "$robot_password" ]] && log_error "Password cannot be empty" && return 1
    echo

    if ! sshpass -p "$robot_password" ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$ssh_address" exit; then
        log_error "Cannot connect to remote system '$ssh_address'"
        return 1
    fi
    log_info "SSH connection successful"
    return 0
}

# Remote setup helper functions
remote_exec() {
    local host="$1"
    local cmd="$2"
    local password="$3"
    local warn="${4:-}"  # Optional fourth argument (defaults to empty)

    local sshpass_prefix=()
    if [[ -n "$password" ]]; then
        sshpass_prefix=(sshpass -p "$password")
    fi

    if ! "${sshpass_prefix[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$host" "$cmd"; then
        if [ "$warn" = "warn" ]; then
            error_warn "Failed to execute (proceeding): $cmd on $host"
        else
            error_exit "Failed to execute: $cmd on $host"
        fi
    fi
}

remote_copy() {
    local src="$1"
    local dest="$2"
    local password="$3"

    local sshpass_prefix=()
    if [[ -n "$password" ]]; then
        sshpass_prefix=(sshpass -p "$password")
    fi

    "${sshpass_prefix[@]}" scp -P "${SSH_PORT:-22}" "$src" "$dest" || error_exit "Failed to copy: $src to $dest"
}

read_remote_variable() {
    local host="$1"
    local password="$2"
    local variable_name="$3"

    # Use remote_exec to fetch the variable value
    local variable_value
    variable_value=$(remote_exec "$host" "echo \$$variable_name" "$password") || {
        log_warn "Failed to fetch variable $variable_name from $host"
    }

    # Return the variable value as the function output
    echo "$variable_value"
}


# Function to read environment variables from a YAML file
read_env_from_yaml() {
    local yaml_file="$1"
    local robot_name="$2"
    local output_file="$3"

    # Check if the YAML file exists
    if [ ! -f "$yaml_file" ]; then
        log_error "YAML file not found at $yaml_file"
        return 1
    fi

    # Extract environment variables for the specified robot
    sed -n "/^  $robot_name:/,/^  [^[:space:]]/p" "$yaml_file" | \
    	sed -E "1d" | \
        sed -E 's/^    ([^:]+):[[:space:]]*"?(.*)"?$/\1=\2/' | \
        sed -E 's/"$//' | \
        sed '$d' | \
        sed '$d' > "$output_file"

    if [ -s "$output_file" ]; then
        log_info "Environment variables for $robot_name have been extracted to $output_file:"
        cat "$output_file"
    else
        log_error "No environment variables found for $robot_name in $yaml_file"
        return 1
    fi
}

setup_remote() {
    local robot_name="$1"
    local airlab_path="$2"
    local force="$3"
    local force_password="${4:-false}"
    local address="${5:-}"
    local airlab_src="${6:-}"
    local offline="${7:-false}"
    local assume_yes="${8:-false}"
    local keep_env="${9:-false}"
    local no_reboot="${10:-false}"

    # Resolve the operator's AIRLAB_PATH. We source ~/.bashrc, but the stock Ubuntu
    # ~/.bashrc returns early in a NON-interactive shell (the `case $- in *i*) ;; *) return`
    # guard) — which is exactly what we are — so it never reaches the `source .../airlab.env`
    # line and AIRLAB_PATH comes back empty (then "/robot/robot.conf" not found). Recover it:
    # honor an AIRLAB_PATH already in the environment (e.g. `sudo -E`/`sudo AIRLAB_PATH=...`),
    # else source the airlab.env that ~/.bashrc points at, else fall back to the default.
    source "$USER_HOME/.bashrc" 2>/dev/null
    if [[ -z "${AIRLAB_PATH:-}" ]]; then
        local _env_file
        _env_file=$(grep -m1 -oE 'source +[^ ;]*airlab\.env' "$USER_HOME/.bashrc" 2>/dev/null | sed -E 's/^source +//')
        if [[ -n "$_env_file" && -f "$_env_file" ]]; then
            set -o allexport; source "$_env_file"; set +o allexport
        elif [[ -f "$DEFAULT_AIRLAB_PATH/airlab.env" ]]; then
            set -o allexport; source "$DEFAULT_AIRLAB_PATH/airlab.env"; set +o allexport
        fi
    fi
    : "${AIRLAB_PATH:=$DEFAULT_AIRLAB_PATH}"
    local remote_path=$AIRLAB_PATH
    local robots_conf="$remote_path/robot/robot.conf"
    [[ ! -f "$robots_conf" ]] && error_exit "Robot configuration not found: $robots_conf (resolved AIRLAB_PATH='$remote_path')"

    # Resolve robot SSH address (registry-aware; robot.conf fallback), then split into a bare
    # user@host + SSH_PORT so every ssh/scp/rsync below honors a port-bearing
    # (ssh://user@host:port) address. SSH_PORT is global so the helpers below see it.
    local robot_ssh_address
    robot_ssh_address=$(resolve_ssh_address "$robot_name" "$address")
    [[ -z "$robot_ssh_address" ]] && error_exit "Robot '$robot_name'${address:+ (address '$address')} not found in robots.yaml or $robots_conf"
    SSH_PORT=22
    robot_ssh_address="${robot_ssh_address#ssh://}"
    if [[ "$robot_ssh_address" == *:* ]]; then
        SSH_PORT="${robot_ssh_address##*:}"; robot_ssh_address="${robot_ssh_address%:*}"
    fi

    # Authenticate via SSH (robot_password is set by ssh_authenticate)
    robot_password=""
    if ! ssh_authenticate "$robot_ssh_address" "$force_password"; then
        exit 1
    fi

    local SSHPASS_PREFIX=()
    if [[ -n "$robot_password" ]]; then
        SSHPASS_PREFIX=(sshpass -p "$robot_password")
    fi

    # Check existing installation
    log_info "Checking existing installation..."
    remote_home_dir=$("${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$robot_ssh_address" "echo \$HOME" | sed 's/^HOME=//')
    airlab_path=$(echo "$airlab_path" | sed "s|^~|$remote_home_dir|")

    log_info "Checking for workspace setup at $airlab_path"

    if "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$robot_ssh_address" "[ -d '$airlab_path' ]"; then
        log_warn "Directory exists."
        if [ "$keep_env" = true ]; then
            # In-field re-provisioning: update the repo content in place and KEEP
            # the robot's existing airlab.env (and anything else already there).
            log_warn "--keep-env set. Updating in place; the robot's existing airlab.env is preserved."
        elif [ "$force" = true ] || [ "$assume_yes" = true ]; then
            log_warn "Force flag set. Overwriting existing installation..."
            log_warn "Removing existing installation..."
            remote_exec "$robot_ssh_address" "rm -rf $airlab_path" "$robot_password"
        else
            log_warn "Directory exists. Existing installation will be removed."
            log_warn "This will delete all files in the directory."
            log_warn "Please ensure you have a backup of important files."
            read -p "Installation exists at $airlab_path. Overwrite? (y/N): " confirm
            [[ ! "$confirm" =~ ^[Yy]$ ]] && error_exit "Setup cancelled"
            log_warn "Removing existing installation..."
            remote_exec "$robot_ssh_address" "rm -rf $airlab_path" "$robot_password"
        fi
    fi

    # Setup remote environment
    log_info "Setting up remote environment..."

    # All git/source ops run as $SUDO_USER: the local repo is owned by them
    # (modern git refuses cross-user reads), and `git clone` over SSH needs their keys.
    local -a as_user
    if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
        as_user=(sudo -u "$SUDO_USER" --)
    else
        as_user=()
    fi

    # We only ever send the airlab_ws REPO CONTENT to the robot — never the
    # vcs-managed *_ws workspace folders (delivered later by `airlab sync`).
    # Under --keep-env we additionally leave the robot's airlab.env and the local
    # robot_info.yaml untouched.
    local -a rsync_excludes=(--exclude='.git')
    if [ "$keep_env" = true ]; then
        rsync_excludes+=(--exclude='airlab.env' --exclude='robot/robot_info.yaml')
    fi

    # Single cleanup for whichever temp we create below (online clone / offline ignore-list).
    local clone_dir="" ignore_file="" src_dir=""
    trap '[ -n "$clone_dir" ] && rm -rf "$clone_dir"; [ -n "$ignore_file" ] && rm -f "$ignore_file"' EXIT

    if [ "$offline" = true ]; then
        # OFFLINE: no network, no clone. Send the local working tree's repo content
        # by rsyncing $remote_path while excluding everything git ignores (the *_ws
        # folders, weights/, debug/, …) — computed via `git ls-files`.
        log_info "Offline: sending airlab_ws repo content from local working tree $remote_path (no clone)"
        ignore_file="$(mktemp -t airlab-ws-ignore.XXXXXX)"
        "${as_user[@]}" git -C "$remote_path" ls-files --others --ignored --exclude-standard --directory \
            > "$ignore_file" 2>/dev/null \
            || error_exit "$remote_path is not a git repo; cannot compute the offline exclude list"
        rsync_excludes+=(--exclude-from="$ignore_file")
        src_dir="$remote_path/"
    else
        # ONLINE: robot gets a fresh clone of origin/main of the local $AIRLAB_PATH,
        # not the host's working tree. Keeps fleet state canonical.
        local origin_url
        origin_url=$("${as_user[@]}" git -C "$remote_path" remote get-url origin 2>/dev/null) \
            || error_exit "$remote_path is not a git repo (or has no 'origin'); cannot resolve source for remote install"

        log_info "Source: $origin_url (main)"
        "${as_user[@]}" git -C "$remote_path" fetch --quiet origin main 2>/dev/null \
            || log_warn "Could not fetch origin/main; comparison may be stale"

        local ahead_commits dirty_files
        ahead_commits=$("${as_user[@]}" git -C "$remote_path" log --oneline origin/main..HEAD 2>/dev/null)
        dirty_files=$("${as_user[@]}" git -C "$remote_path" status -s 2>/dev/null)

        if [[ -n "$ahead_commits" || -n "$dirty_files" ]]; then
            log_warn "Local $remote_path differs from origin/main; the changes below will NOT land on the robot:"
            if [[ -n "$ahead_commits" ]]; then
                echo "  Commits ahead of origin/main:"
                echo "$ahead_commits" | sed 's/^/    /'
            fi
            if [[ -n "$dirty_files" ]]; then
                echo "  Uncommitted changes:"
                echo "$dirty_files" | sed 's/^/    /'
            fi
            if [ "$force" = true ] || [ "$assume_yes" = true ]; then
                log_warn "Force flag set; proceeding with origin/main only."
            else
                read -p "Proceed with origin/main on the robot? (y/N): " confirm
                [[ ! "$confirm" =~ ^[Yy]$ ]] && error_exit "Setup cancelled"
            fi
        fi

        clone_dir="$("${as_user[@]}" mktemp -d -t airlab-ws-clone.XXXXXX)"
        if [ -z "$clone_dir" ] || [ ! -d "$clone_dir" ] || [ "$clone_dir" = "/" ] || [ "${clone_dir#/}" = "$clone_dir" ]; then
            error_exit "Refusing to proceed: invalid clone tmp dir: '$clone_dir'"
        fi
        log_info "Cloning $origin_url (main) into $clone_dir/airlab_ws ..."
        "${as_user[@]}" git clone --depth 1 --branch main "$origin_url" "$clone_dir/airlab_ws" \
            || error_exit "Failed to clone $origin_url (main)"
        src_dir="$clone_dir/airlab_ws/"
    fi

    # Create directory structure
    remote_exec "$robot_ssh_address" "mkdir -p $airlab_path" "$robot_password"

    # Copy files (repo content only)
    log_info "Copying configuration files to robot..."
    "${SSHPASS_PREFIX[@]}" rsync -avz -e "ssh -o StrictHostKeyChecking=no -p ${SSH_PORT:-22}" "${rsync_excludes[@]}" \
        "$src_dir" "$robot_ssh_address:$airlab_path/" || error_exit "Failed to copy files"

    # Resolve install source — recorded at .deb-build time so each fork's
    # package fetches from its own repo without baking the URL into code.
    local source_repo source_url
    source_repo=$(cat /usr/share/airlab/install_source 2>/dev/null || echo "strapsai/airlab")
    source_url="https://github.com/${source_repo}/archive/refs/heads/main.zip"

    # Decide whether to (re)install the airlab tool package on the robot.
    local do_install=true
    if "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$robot_ssh_address" "dpkg -l | grep -q '^ii.*airlab'" ; then
        if [ "$assume_yes" = true ] || [ "$force" = true ]; then
            log_info "airlab package already installed; reinstalling from the provided source."
        else
            read -p "airlab package is installed. Unpack newer verison? (y/N): " confirm
            [[ ! "$confirm" =~ ^[Yy]$ ]] && { log_warn "Skipping installation"; do_install=false; }
        fi
    fi

    if [ "$do_install" = true ]; then
        log_info "Installing airlab package..."
        remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S rm -rf /tmp/airlab-main /tmp/airlab-main.deb /tmp/airlab.zip" "$robot_password"

        # Deliver the airlab tool source to the robot at /tmp/airlab-main.
        if [ -n "$airlab_src" ]; then
            # LOCAL source (offline-capable): rsync the tree directly — no GitHub download.
            log_info "Sending local airlab tool source from $airlab_src ..."
            "${SSHPASS_PREFIX[@]}" rsync -avz -e "ssh -o StrictHostKeyChecking=no -p ${SSH_PORT:-22}" --exclude='.git' \
                "${airlab_src%/}/" "$robot_ssh_address:/tmp/airlab-main/" || error_exit "Failed to send local airlab source to robot"
        else
            # LEGACY online path: download the tool zip from GitHub, copy, unzip.
            sudo curl -L -o /tmp/airlab.zip "$source_url"
            remote_copy "/tmp/airlab.zip" "$robot_ssh_address:/tmp/airlab.zip" "$robot_password"
            remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S unzip -o /tmp/airlab.zip -d /tmp/" "$robot_password"
        fi
        remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S chmod a+x -R /tmp/airlab-main" "$robot_password"

        # Run install.sh on the robot NON-INTERACTIVELY (we drive it over ssh -tt with no
        # operator at the keyboard, so any prompt would hang). install.sh prompts only about
        # the venv when one already exists, so pass an explicit venv mode:
        #   offline -> --offline   : reuse the existing venv (and skip apt/pip; no network)
        #   online  -> --override-venv : (re)create the managed ~/VENVs/airlab venv; works
        #              whether or not it already exists, and never prompts. (Without this, a
        #              re-provision of a robot that already has the venv blocks forever on
        #              install.sh's "Remove and re-create it? [y/N]" prompt.)
        # ssh -tt: pty makes sudo's timestamp cache survive into install.sh's internal sudo
        # calls. install.sh must run as user (not root) so its ~/VENVs and ~/.bashrc edits
        # use the right $HOME.
        local install_flags=""
        if [ "$offline" = true ]; then
            install_flags=" --offline"
        else
            install_flags=" --override-venv"
        fi
        "${SSHPASS_PREFIX[@]}" ssh -tt -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$robot_ssh_address" "echo '$robot_password' | sudo -S echo HERE && bash /tmp/airlab-main/install.sh${install_flags}" \
            || error_exit "Failed to run install.sh on $robot_ssh_address"

        # install.sh already builds a CLEAN .deb (from its own staging dir) and installs it.
        # The legacy online path additionally rebuilt+reinstalled the raw /tmp/airlab-main and
        # ran apt-get -f; we keep that only for the online path (it needs the network and would
        # repackage stray files). For local-source/offline we rely on install.sh's clean install.
        if [ -z "$airlab_src" ]; then
            remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S dpkg-deb --build /tmp/airlab-main" "$robot_password"
            remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S dpkg -i /tmp/airlab-main.deb" "$robot_password" "warn"
            remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S apt-get install -f -y" "$robot_password"
        fi
        remote_exec "$robot_ssh_address" "echo '$robot_password' | sudo -S rm -rf /tmp/airlab-main /tmp/airlab-main.deb /tmp/airlab.zip" "$robot_password"
    fi

    local yaml_file="$remote_path/robot/robot_info.yaml"

    if [ "$keep_env" = true ]; then
        log_info "--keep-env: preserving the robot's existing airlab.env and the local robot_info.yaml (no changes)."
    elif grep -q "^  $robot_name:" "$yaml_file"; then
        log_info "Robot name '$robot_name' found in $yaml_file."
        local _proceed_existing=false
        if [ "$assume_yes" = true ] || [ "$force" = true ]; then
            _proceed_existing=true
            log_info "Proceeding with existing variables (non-interactive)."
        else
            read -p "Found exsisting env variables. Proceed with them(y) or overwrite them(N) verison? (y/N): " confirm
            [[ "$confirm" =~ ^[Yy]$ ]] && _proceed_existing=true
        fi
        if [ "$_proceed_existing" = false ]; then
            log_warn "Overwriting exsisting variables"
            user_name=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -un)")
            group_name=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -gn)")
            group_id=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -g)")
            user_id=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -u)")

            local docker_build=$airlab_path/docker/docker-compose.yml
            local docker_up=$airlab_path/docker/docker-compose.yml
            local launch_path=$airlab_path/launch/sample.yaml
            log_info "Updating robot configuration..."
            update_robot_info "$remote_path" "$robot_name" "robot_ssh" "$robot_ssh_address"
            update_robot_info "$remote_path" "$robot_name" "ws_path" "$airlab_path"
            update_robot_info "$remote_path" "$robot_name" "AIRLAB_PATH" "$airlab_path"
            update_robot_info "$remote_path" "$robot_name" "ROBOT_NAME" "$robot_name"
            update_robot_info "$remote_path" "$robot_name" "AIRLAB_SYSTEM" "$robot_name"
            update_robot_info "$remote_path" "$robot_name" "USER_NAME" "$user_name"
            update_robot_info "$remote_path" "$robot_name" "USER" "$user_name"
            update_robot_info "$remote_path" "$robot_name" "GROUP_NAME" "$group_name"
            update_robot_info "$remote_path" "$robot_name" "GROUP_ID" "$group_id"
            update_robot_info "$remote_path" "$robot_name" "USER_ID" "$user_id"
            update_robot_info "$remote_path" "$robot_name" "DOCKER_BUILD_PATH" "$docker_build" --no-overwrite docker_build
            update_robot_info "$remote_path" "$robot_name" "DOCKER_UP_PATH" "$docker_up" --no-overwrite docker_up
            update_robot_info "$remote_path" "$robot_name" "LAUNCH_FILE_PATH" "$launch_path" --no-overwrite launch_path

            log_warn "Updating environment variables..."
            # Configure environment
            log_info "Configuring environment..."
                cat > /tmp/airlab.env << EOF
AIRLAB_PATH=$airlab_path
AIRLAB_SYSTEM=$robot_name
ROBOT_NAME=$robot_name
USER_NAME=\${SUDO_USER:-\$USER}
USER=\${SUDO_USER:-\$USER}
GROUP_NAME=\$(id -gn)
GROUP_ID=\$(id -g)
USER_ID=\$(id -u)
DOCKER_BUILD_PATH=$docker_build
DOCKER_UP_PATH=$docker_up
LAUNCH_FILE_PATH=$launch_path
EOF
        else
            log_info "Proceeding with existing variables"
            read_env_from_yaml "$yaml_file" "$robot_name" "/tmp/airlab.env"
        fi
    else
        user_name=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -un)")
        group_name=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -gn)")
        group_id=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -g)")
        user_id=$(read_remote_variable "$robot_ssh_address" "$robot_password" "(id -u)")

        local docker_build=$airlab_path/docker/docker-compose.yml
        local docker_up=$airlab_path/docker/docker-compose.yml
        local launch_path=$airlab_path/launch/sample.yaml
        log_info "Updating robot configuration..."
        update_robot_info "$remote_path" "$robot_name" "robot_ssh" "$robot_ssh_address"
        update_robot_info "$remote_path" "$robot_name" "ws_path" "$airlab_path"
        update_robot_info "$remote_path" "$robot_name" "AIRLAB_PATH" "$airlab_path"
        update_robot_info "$remote_path" "$robot_name" "ROBOT_NAME" "$robot_name"
        update_robot_info "$remote_path" "$robot_name" "AIRLAB_SYSTEM" "$robot_name"
        update_robot_info "$remote_path" "$robot_name" "USER_NAME" "$user_name"
        update_robot_info "$remote_path" "$robot_name" "USER" "$user_name"
        update_robot_info "$remote_path" "$robot_name" "GROUP_NAME" "$group_name"
        update_robot_info "$remote_path" "$robot_name" "GROUP_ID" "$group_id"
        update_robot_info "$remote_path" "$robot_name" "USER_ID" "$user_id"
        update_robot_info "$remote_path" "$robot_name" "DOCKER_BUILD_PATH" "$docker_build" --no-overwrite docker_build
        update_robot_info "$remote_path" "$robot_name" "DOCKER_UP_PATH" "$docker_up" --no-overwrite docker_up
        update_robot_info "$remote_path" "$robot_name" "LAUNCH_FILE_PATH" "$launch_path" --no-overwrite launch_path

        log_warn "Updating environment variables..."
        # Configure environment
        log_info "Configuring environment..."
            cat > /tmp/airlab.env << EOF
AIRLAB_PATH=$airlab_path
AIRLAB_SYSTEM=$robot_name
ROBOT_NAME=$robot_name
USER_NAME=$user_name
USER=$user_name
GROUP_NAME=$group_name
GROUP_ID=$group_id
USER_ID=$user_id
DOCKER_BUILD_PATH=$docker_build
DOCKER_UP_PATH=$docker_up
LAUNCH_FILE_PATH=$launch_path
EOF
    fi

    if [ "$keep_env" != true ]; then
        remote_copy "/tmp/airlab.env" "$robot_ssh_address:$airlab_path/airlab.env" "$robot_password"
        rm -f /tmp/airlab.env
    fi

    # Update remote .bashrc
    remote_exec "$robot_ssh_address" "sed -i '/source .*airlab.env/d' ~/.bashrc" "$robot_password"
    remote_exec "$robot_ssh_address" "grep -q 'source $airlab_path/airlab.env' ~/.bashrc || \
        echo 'set -o allexport; source $airlab_path/airlab.env; set +o allexport' >> ~/.bashrc" "$robot_password"
    # Update remote .zshrc for zsh users (default-zsh target, or an existing .zshrc)
    remote_exec "$robot_ssh_address" "if command -v zsh >/dev/null 2>&1 && { [ -f ~/.zshrc ] || [ \"\$(basename \${SHELL:-})\" = zsh ]; }; then touch ~/.zshrc; sed -i '/source .*airlab.env/d' ~/.zshrc; grep -q 'source $airlab_path/airlab.env' ~/.zshrc || echo 'set -o allexport; source $airlab_path/airlab.env; set +o allexport' >> ~/.zshrc; fi" "$robot_password"

    cat << EOF
Installation details:
  - Host: $robot_ssh_address
  - Path: $airlab_path
  - System: $robot_name
  
Note: Run 'source ~/.bashrc' (or ~/.zshrc) on the remote system to apply changes
EOF
    log_info "✅ Remote setup completed successfully!"

    log_info "It is recommended to reboot the remote system"
    if [ "$no_reboot" = true ]; then
        log_info "Skipping reboot (--no-reboot). Please reboot the system manually if needed."
        return 0
    fi
    local reboot_confirm="n"
    if [ "$assume_yes" = true ]; then
        log_info "Non-interactive: skipping reboot. Reboot manually if needed (override with an interactive run)."
    else
        read -p "Restart the system (y/n)" reboot_confirm
    fi
    if [[ "$reboot_confirm" == [yY] ]]; then
        "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no -p "${SSH_PORT:-22}" "$robot_ssh_address" "echo '$robot_password' | sudo -S reboot"
    else
        log_info "Skipping"
        log_info "Please reboot the system manually"
    fi
}

main() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "This script must be run as root. Please use sudo."
        exit 1
    fi
    [[ $# -lt 1 ]] && { show_usage; error_exit "No command provided"; }

    local command="$1"
    shift

    parse_args "$@"

    case "$command" in
        local)
            setup_local "$PARSED_PATH" "$PARSED_FORCE"
            ;;
        -h|--help)
            show_usage
            ;;
        *)
            setup_remote "$command" "~/airlab_ws" "$PARSED_FORCE" "$PARSED_PASSWORD" "$PARSED_ADDRESS" \
                "$PARSED_AIRLAB_SRC" "$PARSED_OFFLINE" "$PARSED_YES" "$PARSED_KEEP_ENV" "$PARSED_NO_REBOOT"
            ;;
    esac
}

main "$@"