#!/bin/bash
# airlab compose — this machine's `docker compose` command, prefilled or run.
#
#   airlab compose                 prefill the command onto your prompt (edit, then run)
#   airlab compose up -d           RUN it with those arguments, from $AIRLAB_PATH/launch
#   airlab compose down            same — one command that means the same thing everywhere
#
# Bare, it still just hands you the command and gets out of the way. With arguments it
# runs Compose for you, so an operator (or a script, or `airlab exec <robot> ...`) has a
# single invocation that works on any configured machine without knowing which compose
# file or profiles that machine elected. Arguments are passed to Compose verbatim, so
# every subcommand keeps working: up / down / config / ps / logs / build / restart / ...
#
# The elected file + profiles come from airlab.env (per machine):
#   AIRLAB_COMPOSE_FILE=docker-compose-basestation.yaml    # a file under $AIRLAB_PATH/launch/
#   AIRLAB_COMPOSE_PROFILES="fleet storage-tools"           # space- or comma-separated
#
# Normally invoked through the airlab shell function (zsh/bash), which cd's to
# $AIRLAB_PATH/launch and prefills the emitted command onto your prompt. Run directly
# (or without the shell integration) it just prints the command for you to copy.

set -uo pipefail

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'
err() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

emit=false
dry_run=false
build_only=false
profiles_override=""
profiles_override_set=false
# airlab's own options come first; the first argument that isn't one of them (or a
# literal `--`) starts the Compose arguments, which are passed through verbatim.
while [ $# -gt 0 ]; do
    case "$1" in
        --emit)        emit=true; shift ;;
        --dry-run)     dry_run=true; shift ;;
        --build-only)  build_only=true; shift ;;
        --profiles)
            [ $# -ge 2 ] || { err "--profiles needs a value, e.g. --profiles fleet,db"; exit 2; }
            profiles_override="$2"; profiles_override_set=true; shift 2 ;;
        --profiles=*)  profiles_override="${1#*=}"; profiles_override_set=true; shift ;;
        -h|--help)
            cat <<'EOF'
Usage: airlab compose [--dry-run] [--build-only] [--profiles <a,b,...>] [docker-compose-args...]

This machine's `docker compose` command — prefilled, or run for you.

  airlab compose              Prefill the command onto your prompt (edit it, then run).
  airlab compose up -d        Run it with those arguments, from $AIRLAB_PATH/launch.
  airlab compose down         Same. One command that means the same thing on every machine.
  airlab compose --dry-run up -d
                              Print exactly what would run; run nothing.

Profile selection (put these BEFORE the Compose arguments):
  --build-only                Keep only the profiles whose name ends in "-build".
                              Errors if none remain.
  --profiles <a,b,...>        Use this profile list instead of AIRLAB_COMPOSE_PROFILES
                              (comma- or space-separated). Combined with --build-only,
                              --build-only filters this list.

  airlab compose --build-only               prefill a build-profiles-only command
  airlab compose --build-only build         build just the -build profiles
  airlab compose --profiles fleet,db up -d  bring up exactly these profiles

The elected compose file and profiles come from airlab.env, so the SAME command brings
the right stack up on a basestation, a robot, or a GPU box. Arguments are handed to
Compose verbatim — config, ps, logs, build, restart and friends all work.

Set in airlab.env, e.g.:
  AIRLAB_COMPOSE_FILE=docker-compose-basestation.yaml
  AIRLAB_COMPOSE_PROFILES="fleet storage-tools"
EOF
            exit 0 ;;
        --)            shift; break ;;
        *)             break ;;
    esac
done

if [ -z "${AIRLAB_PATH:-}" ]; then
    err "AIRLAB_PATH is not set — run 'airlab setup local' first."
    exit 1
fi
env_file="${AIRLAB_PATH}/airlab.env"
if [ ! -f "$env_file" ]; then
    err "airlab.env not found at ${env_file} — run the deployer (launch/deployer/deployer)."
    exit 1
fi

# Read KEY=VALUE from airlab.env as TEXT (never sourced); the last assignment wins.
# Tolerates what a hand-edited env file contains: leading whitespace, an `export `
# prefix, a single- or double-quoted value with anything after the closing quote
# (trailing spaces, `# comment`), and an unquoted value with a trailing ` # comment`
# or trailing whitespace. Quoted values are taken literally up to the closing quote.
read_env() {
    local key="$1" line val out=""
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        if [[ "$line" == export[[:space:]]* ]]; then
            line="${line#export}"
            line="${line#"${line%%[![:space:]]*}"}"
        fi
        [[ "$line" == "${key}="* ]] || continue
        val="${line#"${key}="}"
        case "$val" in
            \"*) val="${val#\"}"; val="${val%%\"*}" ;;
            \'*) val="${val#\'}"; val="${val%%\'*}" ;;
            *)   val="${val%%[[:space:]]#*}"
                 val="${val%"${val##*[![:space:]]}"}" ;;
        esac
        out="$val"
    done < "$env_file"
    printf '%s' "$out"
}

compose_file="$(read_env AIRLAB_COMPOSE_FILE)"
profiles_raw="$(read_env AIRLAB_COMPOSE_PROFILES)"

if [ -z "$compose_file" ]; then
    err "AIRLAB_COMPOSE_FILE is not set in ${env_file}."
    err "Set it to this machine's elected compose file, e.g. docker-compose-basestation.yaml"
    exit 1
fi
if [ ! -f "${AIRLAB_PATH}/launch/${compose_file}" ]; then
    err "AIRLAB_COMPOSE_FILE='${compose_file}' not found under ${AIRLAB_PATH}/launch/."
    exit 1
fi
if [ "$profiles_override_set" = true ]; then
    profiles_raw="$profiles_override"
    profiles_src="--profiles"
else
    profiles_src="AIRLAB_COMPOSE_PROFILES"
fi
if [ -z "${profiles_raw//[[:space:],]/}" ]; then
    if [ "$profiles_override_set" = true ]; then
        err "--profiles was given an empty list."
    else
        err "AIRLAB_COMPOSE_PROFILES is not set in ${env_file}."
        err "Set it to the profiles this machine runs, e.g. \"fleet storage-tools\""
    fi
    exit 1
fi

# Profiles are space- or comma-separated.
read -r -a _all_profiles <<< "${profiles_raw//,/ }"
_profiles=()
for p in "${_all_profiles[@]}"; do
    [ -z "$p" ] && continue
    if [ "$build_only" = true ] && [[ "$p" != *-build ]]; then
        continue
    fi
    _profiles+=("$p")
done
if [ "$build_only" = true ] && [ "${#_profiles[@]}" -eq 0 ]; then
    err "--build-only: no profile ending in '-build' in ${profiles_src} (${_all_profiles[*]})."
    exit 1
fi

# Build the command (run from $AIRLAB_PATH/launch — the shell function cd's there).
# No --env-file: airlab.env is already sourced/exported into the operator's shell
# (the same assumption the launch Makefiles make), so compose interpolates ${VAR}
# from the environment.
cmd="docker compose -f ${compose_file}"
for p in "${_profiles[@]}"; do
    cmd="${cmd} --profile ${p}"
done
cmd="${cmd} "   # trailing space so you type the subcommand (up -d / down / config / ...)

# No arguments: hand over the command, as before.
if [ "$#" -eq 0 ]; then
    if [ "$emit" = true ]; then
        printf '%s' "$cmd"
    else
        printf '%s\n' "$cmd"
        echo -e "${YELLOW}[tip]${NC} Run the above from \$AIRLAB_PATH/launch — or use the airlab shell" >&2
        echo -e "      integration (zsh/bash) so 'airlab compose' cd's there and prefills it for you." >&2
    fi
    exit 0
fi

# Arguments given: run Compose ourselves.
#
# --env-file is added HERE but deliberately not in the prefilled form. The prefilled
# command is typed into an interactive shell, where ~/.bashrc has already exported
# airlab.env, so it is redundant there (see the review that removed it). Running
# non-interactively has no such guarantee — over `airlab exec`, ssh or ansible the
# stock ~/.bashrc early-returns and nothing exports airlab.env, which would leave
# ${ARCH} and friends empty and render the wrong stack.
#
# For ${VAR} INTERPOLATION the real environment still wins over --env-file, so an
# explicit `GATE_LANE=gate3 airlab compose up` overrides the file — it is a floor, not
# an override. (Verified: `ARCH=nonsense` resolves to nonsense.env, not the file's x86.)
# What a CONTAINER sees is a separate matter: that comes from each service's `env_file:`
# — base-service loads airlab.env directly — and is unaffected by either.
cd "${AIRLAB_PATH}/launch" || { err "Cannot cd to ${AIRLAB_PATH}/launch"; exit 1; }

run_cmd=(docker compose --env-file "${env_file}" -f "${compose_file}")
for p in "${_profiles[@]}"; do
    run_cmd+=(--profile "$p")
done
run_cmd+=("$@")

# Show exactly what runs — an operator should never have to guess which stack a bare
# `airlab compose down` just took down.
printf '%s\n' "${run_cmd[*]}" >&2

if [ "$dry_run" = true ]; then
    echo -e "${YELLOW}[dry-run]${NC} nothing was run." >&2
    exit 0
fi

exec "${run_cmd[@]}"
