#!/bin/bash

# Exit on error, undefined variables, and pipe failures
set -euo pipefail

# Shared SSH-address resolution (--address via robots.yaml)
source "$(dirname "$0")/_lib/resolve.sh"
# Remote sudo that works for key- or password-based SSH and NOPASSWD or password sudo.
source "$(dirname "$0")/_lib/remote_sudo.sh"

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Overridable so the write paths can be exercised against a scratch file in tests;
# operationally this is always /etc/hosts.
readonly HOSTS_FILE="${AIRLAB_HOSTS_FILE:-/etc/hosts}"
readonly START_MARKER="# Airlab Hosts Start"
readonly END_MARKER="# Airlab Hosts End"

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

show_usage() {
    cat << EOF
Usage: airlab hosts <subcommand> <target> [options]

Manage the airlab-generated section of /etc/hosts from robots.yaml, on this
machine or on a remote one.

Subcommands:
    set <local|system>      Write the section, so machine names resolve
    compare <local|system>  Report drift between the section and robots.yaml
    remove <local|system>   Delete the section (leaves everything else alone)

Arguments:
    <target>        'local' for this machine's /etc/hosts, or a system name
                    from robots.yaml to act on that machine's over SSH.

Options:
    --address=<name> Use a named network address from robots.yaml (e.g. internet)
    --password      Skip key-based SSH and prompt for password directly
                    (remote targets only)
    --dry-run       Report what would change and write nothing (set, remove)
    --help          Show this help message

Details:
    The registry is ALWAYS the local \$AIRLAB_PATH/robot/robots.yaml, so
    'airlab hosts compare g-uav-1' checks that robot's /etc/hosts against the
    registry you have in front of you.

    Each system's network_addresses become entries: the default address maps to
    the bare name (e.g. g-uav-1), every other address to <system>-<address_name>
    (e.g. g-uav-1-vpn). An address with no 'ip' field is skipped by design (it
    resolves by hostname, not a static IP), as is any address whose composed name
    is not a valid hostname. A summary of everything skipped is printed at the end.

    Only the block between these markers is ever touched:
        $START_MARKER
        ...
        $END_MARKER
    Anything outside them is preserved verbatim.

    'set' and 'remove' take a timestamped backup before writing
    (e.g. /etc/hosts_20260429_160345), local or remote.

    Before writing, 'set' checks for hostname or IP conflicts with entries
    OUTSIDE the markers, and aborts rather than shadowing them.

Exit status:
    compare returns 0 when /etc/hosts matches the registry and 2 when it has
    drifted, so it can gate a script; 1 means the comparison could not be made.

Examples:
    airlab hosts set local                  # write this machine's section
    airlab hosts set g-uav-1                # write it on the robot
    airlab hosts compare local              # what has drifted here?
    airlab hosts compare g-uav-1            # ...and on the robot
    airlab hosts remove local --dry-run     # what would come out?
    airlab hosts remove g-uav-1
EOF
}

check_dependencies() {
    local deps=("ssh" "sudo")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            log_error "Required dependency '$dep' is not installed."
            exit 1
        fi
    done
}

parse_yaml() {
    local yaml_file=$1
    local key=$2
    local result

    if [[ ! -f "$yaml_file" ]]; then
        log_error "YAML file not found: $yaml_file"
        return 1
    fi

    if ! python3 -c "import yaml" 2>/dev/null; then
        log_error "Python YAML module not found. Please install: pip3 install PyYAML"
        return 1
    fi

    result=$(python3 -c '
import sys
import yaml

try:
    with open("'"$yaml_file"'", "r") as f:
        data = yaml.safe_load(f)
        value = data
        for key in "'"$key"'".split("."):
            if not isinstance(value, dict):
                print("")
                sys.exit(1)
            value = value.get(key, "")
        print(value)
except Exception as e:
    print("")
    sys.exit(1)
')

    if [[ -z "$result" ]]; then
        log_error "Failed to parse key '$key' from YAML file"
        return 1
    fi

    echo "$result"
}

ssh_authenticate() {
    local ssh_address=$1
    local force_password=${2:-false}
    robot_password=""

    if [[ "$force_password" == false ]]; then
        log_info "Attempting key-based SSH to $ssh_address..."
        if ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=no -o BatchMode=yes "$ssh_address" exit 2>/dev/null; then
            log_info "Key-based SSH connection successful"
            return 0
        fi
        log_warn "Key-based SSH failed. Falling back to password authentication."
    fi

    if ! command -v sshpass >/dev/null 2>&1; then
        log_error "Key-based SSH failed and 'sshpass' is not installed for password fallback."
        log_error "Either set up SSH keys or install sshpass: sudo apt install sshpass"
        return 1
    fi

    log_info "Enter password for $ssh_address:"
    read -s robot_password
    [[ -z "$robot_password" ]] && log_error "Password cannot be empty" && return 1
    echo

    if ! sshpass -p "$robot_password" ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=no "$ssh_address" exit; then
        log_error "Cannot connect to remote system '$ssh_address'"
        return 1
    fi
    log_info "SSH connection successful"
    return 0
}

# Generate /etc/hosts entries from a robot registry (robots.yaml). For each robot,
# walk its network_addresses: the default address maps to the robot name, every
# other address to "<robot>-<address_name>". An address without an 'ip' field is
# skipped by design (it resolves by hostname, not a static IP), as is any address
# whose composed name is not a valid hostname. Sets two globals:
#   NEW_ENTRIES  newline-separated "IP    hostname" lines
#   SKIPPED      array of "<robot>/<address> — <reason>" strings (for the summary)
generate_from_registry() {
    local robots_yaml="$1"
    local raw
    raw=$(python3 - "$robots_yaml" << 'PY'
import sys, re, yaml
try:
    doc = yaml.safe_load(open(sys.argv[1])) or {}
except Exception as e:
    sys.stderr.write("error: cannot parse %s: %s\n" % (sys.argv[1], e))
    sys.exit(1)
label = r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
host_re = re.compile(r'^%s(?:\.%s)*$' % (label, label))
def valid(h):
    return bool(h) and len(h) <= 253 and bool(host_re.match(h))
for s in doc.get("systems", []):
    name = s.get("system")
    if not name:
        continue
    for a in s.get("network_addresses") or []:
        an = a.get("address_name") or "?"
        host = name if a.get("default") is True else "%s-%s" % (name, an)
        ip = a.get("ip")
        if not ip:
            print("S\t%s/%s\tno 'ip' field" % (name, an))
        elif not valid(host):
            print("S\t%s/%s\tinvalid hostname '%s'" % (name, an, host))
        else:
            print("E\t%s\t%s" % (ip, host))
PY
) || { log_error "Failed to read registry '$robots_yaml' (is PyYAML installed?)"; exit 1; }

    NEW_ENTRIES=""
    SKIPPED=()
    local tag f1 f2
    while IFS=$'\t' read -r tag f1 f2; do
        [[ -z "$tag" ]] && continue
        case "$tag" in
            E) NEW_ENTRIES+="$(printf '%-15s %s' "$f1" "$f2")"$'\n' ;;
            S) SKIPPED+=("$f1 — $f2") ;;
        esac
    done <<< "$raw"
    NEW_ENTRIES="${NEW_ENTRIES%$'\n'}"
}

# Print a summary of network addresses that were NOT added to /etc/hosts, and why.
# Called at the end of a run so the operator sees exactly what was left out.
print_skipped_summary() {
    [[ ${#SKIPPED[@]} -eq 0 ]] && return 0
    echo "" >&2
    log_warn "Skipped ${#SKIPPED[@]} network address(es) — not written to /etc/hosts:"
    local s
    for s in "${SKIPPED[@]}"; do
        echo -e "    ${YELLOW}-${NC} ${s}" >&2
    done
    log_warn "Addresses without an 'ip' are skipped by design (they resolve by hostname, not a static IP)."
}

# Check for conflicts between new entries and existing /etc/hosts content
# (outside the airlab markers). Returns 0 if clean, 1 if conflicts found.
# $1 = hosts file content, $2 = new entries to add
check_conflicts() {
    local hosts_content="$1"
    local new_entries="$2"
    local has_conflict=false

    # Extract lines outside the airlab marker block (skip comments and blanks)
    local outside_lines
    outside_lines=$(echo "$hosts_content" | awk \
        -v start="$START_MARKER" -v end="$END_MARKER" '
        $0 == start { in_block = 1; next }
        $0 == end   { in_block = 0; next }
        !in_block   { print }
    ' | grep -v '^\s*#' | grep -v '^\s*$' || true)

    # Check each new entry against existing entries
    while IFS= read -r new_line; do
        [[ -z "$new_line" ]] && continue

        local new_ip new_hostname
        new_ip=$(echo "$new_line" | awk '{print $1}')
        new_hostname=$(echo "$new_line" | awk '{print $2}')

        # Check for duplicate hostname
        local existing_ip
        existing_ip=$(echo "$outside_lines" | awk -v h="$new_hostname" '
            { for (i=2; i<=NF; i++) if ($i == h) print $1 }
        ' | head -1)

        if [[ -n "$existing_ip" ]]; then
            if [[ "$existing_ip" == "$new_ip" ]]; then
                log_warn "Hostname '$new_hostname' already mapped to $new_ip outside airlab markers (duplicate)"
            else
                log_error "CONFLICT: Hostname '$new_hostname' is already mapped to $existing_ip outside airlab markers (new: $new_ip)"
            fi
            has_conflict=true
        fi

        # Check for duplicate IP with different hostname
        local existing_hostnames
        existing_hostnames=$(echo "$outside_lines" | awk -v ip="$new_ip" '
            $1 == ip { for (i=2; i<=NF; i++) print $i }
        ' || true)

        if [[ -n "$existing_hostnames" ]]; then
            while IFS= read -r eh; do
                if [[ "$eh" != "$new_hostname" ]]; then
                    log_warn "IP $new_ip is already mapped to hostname '$eh' outside airlab markers"
                fi
            done <<< "$existing_hostnames"
        fi
    done <<< "$new_entries"

    if [[ "$has_conflict" == true ]]; then
        return 1
    fi
    return 0
}

# Build the new /etc/hosts content with entries inserted between markers.
# $1 = current hosts file content, $2 = new entries
build_new_hosts() {
    local hosts_content="$1"
    local new_entries="$2"

    if echo "$hosts_content" | grep -q "^${START_MARKER}$"; then
        # Markers exist: replace content between them
        echo "$hosts_content" | awk \
            -v start="$START_MARKER" -v end="$END_MARKER" -v content="$new_entries" '
            $0 == start { print; print content; skip = 1; next }
            $0 == end   { print; skip = 0; next }
            !skip       { print }
        '
    else
        # No markers: append new section
        echo "$hosts_content"
        echo ""
        echo "$START_MARKER"
        echo "$new_entries"
        echo "$END_MARKER"
    fi
}

# --- target-agnostic /etc/hosts access ------------------------------------- #
#
# TARGET_SSH is empty for the local machine and an ssh address otherwise, so the
# three subcommands below are written once and work either way.

# Print the target's /etc/hosts on stdout.
hosts_read() {
    if [[ -z "$TARGET_SSH" ]]; then
        [[ -f "$HOSTS_FILE" ]] || { log_error "$HOSTS_FILE not found"; exit 1; }
        cat "$HOSTS_FILE"
    else
        "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no "$TARGET_SSH" "cat $HOSTS_FILE" || {
            log_error "Failed to read $HOSTS_FILE on $TARGET_SSH"
            exit 1
        }
    fi
}

# True when <path> exists on the target (local or remote).
hosts_path_exists() {
    if [[ -z "$TARGET_SSH" ]]; then
        [[ -e "$1" ]]
    else
        "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no "$TARGET_SSH" "test -e '$1'"
    fi
}

# Pick a backup path that does not already exist. The timestamp is second-granular,
# so a `set` immediately followed by a `remove` would otherwise reuse the same name
# and quietly destroy the first backup — which is the one you would want.
hosts_backup_path() {
    local ts base candidate i=1
    ts="$(date +"%Y%m%d_%H%M%S")"
    base="${HOSTS_FILE}_${ts}"
    candidate="$base"
    while hosts_path_exists "$candidate"; do
        candidate="${base}_${i}"
        i=$((i + 1))
    done
    printf '%s' "$candidate"
}

# Back up the target's /etc/hosts, then replace it with $1. Honours --dry-run.
hosts_write() {
    local content="$1"

    if [[ "$DRY_RUN" == true ]]; then
        log_info "--dry-run: $HOSTS_FILE${TARGET_SSH:+ on $TARGET_SSH} left unchanged."
        return 0
    fi

    local backup_path; backup_path="$(hosts_backup_path)"
    if [[ -z "$TARGET_SSH" ]]; then
        # Only escalate when we cannot write the file as ourselves — /etc/hosts
        # normally needs root, but running as root (or against a scratch file)
        # should not shell out to sudo.
        local SUDO=(sudo)
        [[ -w "$HOSTS_FILE" && -w "$(dirname "$HOSTS_FILE")" ]] && SUDO=()
        log_info "Creating backup: $backup_path"
        "${SUDO[@]}" cp "$HOSTS_FILE" "$backup_path" || { log_error "Failed to create backup"; exit 1; }
        printf '%s\n' "$content" | "${SUDO[@]}" tee "$HOSTS_FILE" > /dev/null
        log_info "Local $HOSTS_FILE updated."
    else
        log_info "Creating remote backup: $backup_path"
        remote_sudo "$TARGET_SSH" "cp $HOSTS_FILE $backup_path" || {
            log_error "Failed to create backup on $TARGET_SSH"; exit 1; }
        # Stage without sudo so stdin carries the content, then sudo-install it:
        # remote_sudo needs stdin for the password, so the two can't share it.
        local remote_tmp="/tmp/airlab_hosts.$$"
        printf '%s\n' "$content" | "${SSHPASS_PREFIX[@]}" ssh -o StrictHostKeyChecking=no \
            "$TARGET_SSH" "cat > $remote_tmp" || {
            log_error "Failed to stage new $HOSTS_FILE on $TARGET_SSH"; exit 1; }
        remote_sudo "$TARGET_SSH" "install -m 0644 $remote_tmp $HOSTS_FILE && rm -f $remote_tmp" || {
            log_error "Failed to update $HOSTS_FILE on $TARGET_SSH"; exit 1; }
        log_info "Remote $HOSTS_FILE on $TARGET_SSH updated."
    fi
}

# Echo the "IP hostname" lines currently inside the airlab markers.
hosts_managed_block() {
    printf '%s\n' "$1" | awk -v start="$START_MARKER" -v end="$END_MARKER" '
        $0 == start { in_block = 1; next }
        $0 == end   { in_block = 0; next }
        in_block    { print }
    ' | grep -v '^\s*#' | grep -v '^\s*$' || true
}

# --- subcommands ------------------------------------------------------------ #

cmd_set() {
    local new_entries="$1"
    local hosts_content; hosts_content="$(hosts_read)"

    log_info "Checking for conflicts with entries outside the airlab markers..."
    if ! check_conflicts "$hosts_content" "$new_entries"; then
        log_error "Conflicts detected. Resolve them manually before proceeding."
        exit 1
    fi
    log_info "No conflicts found."

    echo ""
    log_info "The following entries will be set between the airlab markers${TARGET_SSH:+ on $TARGET_SSH}:"
    printf '%s\n' "$new_entries" | sed 's/^/    /'
    echo ""

    hosts_write "$(build_new_hosts "$hosts_content" "$new_entries")"
}

cmd_compare() {
    local new_entries="$1"
    local hosts_content; hosts_content="$(hosts_read)"
    local installed; installed="$(hosts_managed_block "$hosts_content")"

    local label="local"
    [[ -n "$TARGET_SSH" ]] && label="$TARGET_SSH"
    echo "target:   $label:$HOSTS_FILE"
    echo "registry: $ROBOTS_YAML"
    echo ""

    if ! printf '%s\n' "$hosts_content" | grep -q "^${START_MARKER}$"; then
        log_warn "No airlab section present — /etc/hosts has never been written by airlab."
        echo ""
        echo "MISSING (would be added by 'airlab hosts set'):"
        printf '%s\n' "$new_entries" | sed 's/^/  /'
        return 2
    fi

    # Compare by hostname: the registry is the authority for which IP a name gets.
    local drift=0 matched=0
    local missing="" stale="" mismatched=""
    local ip host installed_ip

    while read -r ip host; do
        [[ -z "$host" ]] && continue
        installed_ip="$(printf '%s\n' "$installed" | awk -v h="$host" '$2 == h { print $1; exit }')"
        if [[ -z "$installed_ip" ]]; then
            missing+="  $(printf '%-15s %s' "$ip" "$host")"$'\n'
        elif [[ "$installed_ip" != "$ip" ]]; then
            mismatched+="  $host: /etc/hosts=$installed_ip  registry=$ip"$'\n'
        else
            matched=$((matched + 1))
        fi
    done <<< "$new_entries"

    while read -r ip host; do
        [[ -z "$host" ]] && continue
        if ! printf '%s\n' "$new_entries" | awk -v h="$host" '$2 == h { found = 1 } END { exit !found }'; then
            stale+="  $(printf '%-15s %s' "$ip" "$host")"$'\n'
        fi
    done <<< "$installed"

    if [[ -n "$mismatched" ]]; then
        echo "IP MISMATCH ($(printf '%s' "$mismatched" | grep -c .)) — the name resolves to the wrong host:"
        printf '%s' "$mismatched"; echo ""
        drift=1
    fi
    if [[ -n "$missing" ]]; then
        echo "MISSING ($(printf '%s' "$missing" | grep -c .)) — in robots.yaml, not in /etc/hosts:"
        printf '%s' "$missing"; echo ""
        drift=1
    fi
    if [[ -n "$stale" ]]; then
        echo "STALE ($(printf '%s' "$stale" | grep -c .)) — in the airlab section, no longer in robots.yaml:"
        printf '%s' "$stale"; echo ""
        drift=1
    fi

    # Entries outside the markers that would block a `set`.
    if ! check_conflicts "$hosts_content" "$new_entries" 2>/dev/null; then
        log_warn "Conflicts exist with entries OUTSIDE the airlab markers; 'hosts set' would abort."
        drift=1
    fi

    if [[ "$drift" -eq 0 ]]; then
        echo "in sync — $matched entries match"
        return 0
    fi
    echo "$matched match"
    return 2
}

cmd_remove() {
    local hosts_content; hosts_content="$(hosts_read)"

    if ! printf '%s\n' "$hosts_content" | grep -q "^${START_MARKER}$"; then
        log_info "No airlab section in $HOSTS_FILE${TARGET_SSH:+ on $TARGET_SSH}; nothing to remove."
        return 0
    fi

    local removed; removed="$(hosts_managed_block "$hosts_content")"
    echo ""
    log_info "The following entries will be REMOVED${TARGET_SSH:+ from $TARGET_SSH}:"
    printf '%s\n' "$removed" | sed 's/^/    /'
    echo ""

    # Drop the markers, everything between them, and a single blank line left
    # immediately before the block (which `set` adds when it first appends).
    local stripped
    stripped="$(printf '%s\n' "$hosts_content" | awk -v start="$START_MARKER" -v end="$END_MARKER" '
        $0 == start { if (blank_pending) blank_pending = 0; in_block = 1; next }
        $0 == end   { in_block = 0; next }
        in_block    { next }
        /^[[:space:]]*$/ { if (blank_pending) print pending; pending = $0; blank_pending = 1; next }
        { if (blank_pending) { print pending; blank_pending = 0 } print }
        END { if (blank_pending) print pending }
    ')"

    hosts_write "$stripped"
}

main() {
    check_dependencies

    if [[ $# -eq 0 ]]; then show_usage; exit 1; fi
    case "$1" in -h|--help|help) show_usage; exit 0 ;; esac

    local subcommand="$1"; shift
    case "$subcommand" in
        set|compare|remove) ;;
        *) show_usage; log_error "Unknown subcommand: $subcommand"; exit 1 ;;
    esac

    if [[ $# -eq 0 ]]; then show_usage; log_error "$subcommand needs a target"; exit 1; fi
    # `hosts set --help` must print help, not look for a system called "--help".
    case "$1" in
        -h|--help) show_usage; exit 0 ;;
        -*)        show_usage; log_error "$subcommand needs a target before its options"; exit 1 ;;
    esac
    local target="$1"; shift

    local FORCE_PASSWORD=false
    local ADDRESS=""
    DRY_RUN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --address)   ADDRESS="$2"; shift ;;
            --address=*) ADDRESS="${1#--address=}" ;;
            --password)  FORCE_PASSWORD=true ;;
            --dry-run)   DRY_RUN=true ;;
            --help|-h)   show_usage; exit 0 ;;
            *)           show_usage; log_error "Invalid option: $1"; exit 1 ;;
        esac
        shift
    done

    if [[ "$DRY_RUN" == true && "$subcommand" == "compare" ]]; then
        log_warn "--dry-run is redundant for compare, which never writes."
    fi

    # The registry is ALWAYS the local one, whatever machine we are acting on:
    # the point of `compare <system>` is to check that machine against the
    # registry in front of the operator.
    ROBOTS_YAML="$AIRLAB_PATH/robot/robots.yaml"
    if [[ ! -f "$ROBOTS_YAML" ]]; then
        log_error "Robot registry not found at '$ROBOTS_YAML'"
        exit 1
    fi
    log_info "Using robot registry: $(realpath "$ROBOTS_YAML")"

    # `remove` deletes the section outright and needs no registry entries.
    local new_entries=""
    if [[ "$subcommand" != "remove" ]]; then
        NEW_ENTRIES=""
        SKIPPED=()
        generate_from_registry "$ROBOTS_YAML"
        new_entries="$NEW_ENTRIES"
        if [[ -z "$new_entries" ]]; then
            log_error "No usable host entries in $ROBOTS_YAML (every address lacked an 'ip' or had an invalid hostname)."
            print_skipped_summary
            exit 1
        fi
    fi

    # Resolve the target: empty TARGET_SSH means this machine.
    TARGET_SSH=""
    SSHPASS_PREFIX=()
    if [[ "$target" != "local" ]]; then
        set +e
        TARGET_SSH=$(resolve_ssh_address "$target" "$ADDRESS")
        set -e
        if [[ -z "$TARGET_SSH" ]]; then
            log_error "System '$target'${ADDRESS:+ (address '$ADDRESS')} not found in robots.yaml"
            exit 1
        fi
        robot_password=""
        ssh_authenticate "$TARGET_SSH" "$FORCE_PASSWORD" || exit 1
        [[ -n "$robot_password" ]] && SSHPASS_PREFIX=(sshpass -p "$robot_password")
    fi

    local rc=0
    case "$subcommand" in
        set)     cmd_set "$new_entries" ;;
        compare) cmd_compare "$new_entries" || rc=$? ;;
        remove)  cmd_remove ;;
    esac

    # Report any network addresses that were intentionally left out.
    [[ "$subcommand" != "remove" ]] && print_skipped_summary
    return $rc
}

main "$@"
