#!/bin/bash

# Exit on undefined variables and pipe failures (not -e — we handle errors
# explicitly, matching the rest of the cmds/ scripts).
set -uo pipefail

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

show_usage() {
    echo -e "${YELLOW}Usage:${NC}"
    echo "  airlab ros2 [--image=<image>] <ros2-command> [args...]"
    echo
    echo "Run an arbitrary 'ros2' sub-command inside a transient Docker"
    echo "container. The container is stopped and removed automatically when"
    echo "the command exits (via 'docker run --rm')."
    echo
    echo "The current working directory is bind-mounted into the container at"
    echo "the same path with -w \$PWD, so relative paths and absolute paths"
    echo "under \$PWD work as expected. \$AIRLAB_PATH is mounted too, along with"
    echo "any folders listed in AIRLAB_DEFAULT_DOCKER_VOLUMES. --network=host is"
    echo "set so DDS discovery reaches nodes on the host."
    echo
    echo -e "${YELLOW}Wrapper options (must precede the ros2 command):${NC}"
    echo "  --image=<image>    Use a specific Docker image. Default: the value of"
    echo "                     AIRLAB_DEFAULT_IMAGE from your airlab.env."
    echo "  --help             Show this help. To get help for a ros2 sub-command,"
    echo "                     pass --help after the sub-command, e.g."
    echo "                     'airlab ros2 bag --help'."
    echo
    echo -e "${YELLOW}Environment (set in \$AIRLAB_PATH/airlab.env):${NC}"
    echo "  AIRLAB_DEFAULT_IMAGE            Docker image to run (machine-specific)."
    echo "  AIRLAB_DEFAULT_DOCKER_VOLUMES   Space-separated host folders to mount"
    echo "                                  (each must exist and be writable)."
    echo
    echo -e "${YELLOW}Examples:${NC}"
    echo "  airlab ros2 bag info ./recording"
    echo "  airlab ros2 topic list"
    echo "  airlab ros2 --image=x86-final:basestation run my_pkg my_node"
}

check_dependencies() {
    if ! command -v docker >/dev/null 2>&1; then
        log_error "Required dependency 'docker' is not installed."
        exit 1
    fi
}

main() {
    local IMAGE="${AIRLAB_DEFAULT_IMAGE:-}"

    # Consume wrapper-specific flags only at the head of the argument list.
    # As soon as we see a non-wrapper token, stop and pass everything that
    # remains through to 'ros2' inside the container — that way
    # `airlab ros2 bag --help` forwards --help to ros2 instead of showing
    # the wrapper's help.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --image=*)
                IMAGE="${1#--image=}"
                shift
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -eq 0 ]]; then
        log_error "No ros2 command given."
        echo
        show_usage
        exit 1
    fi

    # AIRLAB_PATH anchors the workspace mount and the in-container airlab.env.
    if [[ -z "${AIRLAB_PATH:-}" ]]; then
        log_error "AIRLAB_PATH is not set. Run 'sudo airlab setup local' (or source your airlab.env) first."
        exit 1
    fi

    # docker is only needed once we're actually going to run something — check
    # it here (after --help / no-command / AIRLAB_PATH) so help still works
    # without docker installed.
    check_dependencies

    # Image must come from --image or AIRLAB_DEFAULT_IMAGE — no guessing.
    if [[ -z "$IMAGE" ]]; then
        log_error "No Docker image configured for 'airlab ros2'."
        log_error "Set AIRLAB_DEFAULT_IMAGE in \$AIRLAB_PATH/airlab.env (e.g. AIRLAB_DEFAULT_IMAGE=x86-final:basestation) or pass --image=<image>."
        exit 1
    fi

    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        log_error "Docker image '$IMAGE' not found locally."
        log_error "Pull/build it, adjust AIRLAB_DEFAULT_IMAGE in \$AIRLAB_PATH/airlab.env, or pass --image=<image>."
        exit 1
    fi

    # Default mounts: the workspace and the current directory (same path in,
    # same path out). Then any extra folders the machine configured.
    local -a mounts=(-v "$AIRLAB_PATH:$AIRLAB_PATH" -v "$PWD:$PWD")

    # AIRLAB_DEFAULT_DOCKER_VOLUMES: space-separated host folders (may be empty).
    # When set, EVERY folder must exist and be writable by this user, or we stop
    # before creating the container.
    local -a extra_vols=()
    if [[ -n "${AIRLAB_DEFAULT_DOCKER_VOLUMES:-}" ]]; then
        read -r -a extra_vols <<< "$AIRLAB_DEFAULT_DOCKER_VOLUMES"
    fi
    local vol
    for vol in "${extra_vols[@]}"; do
        if [[ ! -d "$vol" ]]; then
            log_error "AIRLAB_DEFAULT_DOCKER_VOLUMES: required folder '$vol' does not exist on the host."
            log_error "Create it (writable by your user), or remove it from AIRLAB_DEFAULT_DOCKER_VOLUMES in \$AIRLAB_PATH/airlab.env."
            exit 1
        fi
        if [[ ! -w "$vol" ]]; then
            log_error "AIRLAB_DEFAULT_DOCKER_VOLUMES: folder '$vol' is not writable by your user ($(id -un))."
            log_error "Fix its permissions, or remove it from AIRLAB_DEFAULT_DOCKER_VOLUMES in \$AIRLAB_PATH/airlab.env."
            exit 1
        fi
        mounts+=(-v "$vol:$vol")
    done

    # Allocate a TTY only when stdin and stdout are real terminals — keeps
    # piping (e.g. 'airlab ros2 topic list | grep foo') working.
    local -a TTY_FLAGS=("-i")
    if [[ -t 0 && -t 1 ]]; then
        TTY_FLAGS+=("-t")
    fi

    log_info "Running 'ros2 $*' in $IMAGE"
    # Inside the container: source the workspace airlab.env (so important env
    # vars are populated), then source the ROS setup — images built on the
    # NVIDIA CUDA base don't put ros2 on PATH by default — then exec ros2.
    # AIRLAB_PATH is passed through so the source path resolves before airlab.env
    # (which also sets it) is read.
    exec docker run --rm "${TTY_FLAGS[@]}" \
        --network=host \
        -e AIRLAB_PATH="$AIRLAB_PATH" \
        "${mounts[@]}" \
        -w "$PWD" \
        "$IMAGE" \
        bash -lc '
            set -o allexport
            [ -f "$AIRLAB_PATH/airlab.env" ] && source "$AIRLAB_PATH/airlab.env"
            set +o allexport
            source /opt/ros/*/setup.bash
            exec ros2 "$@"
        ' _ "$@"
}

main "$@"
