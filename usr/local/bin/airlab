#!/bin/bash

# Function to print usage information for the airlab command

readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

function show_usage() {
    echo -e "${YELLOW}Usage:${NC} airlab <command> [options]"
    echo ""
    echo "Commands:"
    echo "  greet                         Say hello and confirm the command is set up correctly."
    echo "  launch                        Launch a robot configuration based on the provided config file."
    echo "  setup                         Set up the airlab environment on a remote machine."
    echo "  sync                          Synchronize code to a remote machine."
    echo "  docker-build                  Build Docker images using docker-compose."
    echo "  docker-up                     Start Docker containers using docker-compose."
    echo "  docker-join                   Attach to a running Docker container."
    echo "  docker-list                   List active Docker containers."
    echo "  docker-clean                  Stop and remove all Docker containers."
    echo "  ros2                          Run a ros2 command inside a transient Docker container."
    echo "  vcs                           Manage multiple repositories with common git functions."
    echo "  a                             Run a user-defined alias command (see 'airlab a --help')."
    echo "  ping                          Ping a remote robot."
    echo "  ssh                           Connect to a remote machine using SSH."
    echo "  exec                          Run a single command on a remote machine (remote-side expansion)."
    echo "  auth                          Install SSH public key on a remote robot for password-less access."
    echo "  env                           Inspect and synchronise environment variables (see 'airlab env --help')."
    echo "  hosts                         Manage the /etc/hosts section from robots.yaml (see 'airlab hosts --help')."
    echo "  cd                            Change directory relative to \$AIRLAB_PATH (shell function)."
    echo "  compose                       Prefill this machine's 'docker compose' command from airlab.env (shell function)."
    echo "  upgrade                       Upgrade the airlab tool to the latest version from GitHub."
    echo "  --help                        Show this help message."
    echo "  --version                     Show the version of the airlab command."
    echo "Run 'airlab <command>' for specific command usage."
}


# Check if a command is provided
if [ -z "$1" ]; then
    echo "Error: No command provided."
    show_usage
    exit 1
fi

# Get the command and shift to get additional arguments
COMMAND="$1"
shift

# Handle different commands
case "$COMMAND" in
    greet)
        # Call the airlab-greet script
        echo "HELLO"
        ;;
    launch)
        # Call the airlab-launch script with additional arguments
        /usr/local/bin/cmds/robot-launch "$@"
        ;;
    setup)
        # Call the airlab-setup script
        /usr/local/bin/cmds/robot-setup "$@"
        ;;
    sync)
        # Call the airlab-setup script
        /usr/local/bin/cmds/robot-sync "$@"
        ;;
    docker-build)
        # Build Dockerfiles in the right place
        /usr/local/bin/cmds/docker-build "$@"
        ;;
    docker-up)
        # Start Dockerfiles in the right place
        /usr/local/bin/cmds/docker-up "$@"
        ;;
    docker-join)
        # Join Dockerfiles in the right place
        /usr/local/bin/cmds/docker-join "$@"
        ;; 
    docker-list)
        # List Docker containers in the right place
        /usr/local/bin/cmds/docker-list "$@"
        ;;
    docker-clean)
        # Stop and remove all Docker containers
        /usr/local/bin/cmds/docker-clean "$@"
        ;;
    ros2)
        # Pass-through ros2 command into a transient ros2 container
        /usr/local/bin/cmds/ros2 "$@"
        ;;
    vcs)
        # Do git operations on multiple repositories
        /usr/local/bin/cmds/version-control/vcs "$@"
        ;;
    a)
        # Run a user-defined alias command from $AIRLAB_ALIAS_PATH
        /usr/local/bin/cmds/alias "$@"
        ;;
    ping)
        # Ping a remote robot
        /usr/local/bin/cmds/ping "$@"
        ;;
    ssh)
        # ssh into a robot
        /usr/local/bin/cmds/ssh "$@"
        ;;
    exec)
        # run a single command on a remote target (remote-side expansion; streams output + exit code)
        /usr/local/bin/cmds/exec "$@"
        ;;
    auth)
        # Install SSH public key on a remote robot
        /usr/local/bin/cmds/auth "$@"
        ;;
    env)
        # Inspect and synchronise environment variables (airlab.env <-> robot_info.yaml)
        /usr/local/bin/cmds/env "$@"
        ;;
    set_env)
        # Removed in favour of `airlab env set`. Kept only to point the way, since
        # this name is in muscle memory, in scripts, and in older robot_info notes.
        echo "airlab set_env has been replaced by 'airlab env set'." >&2
        echo "  airlab env set local  VAR=value" >&2
        echo "  airlab env set <system> VAR=value" >&2
        echo "Run 'airlab env --help' for the rest of the env subcommands." >&2
        exit 1
        ;;
    hosts)
        # Manage the airlab section of /etc/hosts (set / compare / remove)
        /usr/local/bin/cmds/hosts "$@"
        ;;
    set_hosts)
        # Deprecated alias; the shim warns and forwards to `hosts set`.
        /usr/local/bin/cmds/set_hosts "$@"
        ;;
    compose)
        # Prefill this machine's `docker compose` command (elected file + profiles
        # from airlab.env). Normally intercepted by the airlab shell function, which
        # prefills it onto the prompt; run directly it just prints the command.
        /usr/local/bin/cmds/compose "$@"
        ;;
    upgrade)
        # Self-upgrade the airlab tool to the latest version from GitHub
        /usr/local/bin/cmds/upgrade "$@"
        ;;
    --help)
        show_usage
        exit 0
        ;;
    --version)
        VERSION=$(dpkg-query --show --showformat='${Version}' airlab 2>/dev/null)
        if [ -z "$VERSION" ]; then
            echo "Is the airlab package installed?"
        else
            echo "Airlab version v$VERSION"
        fi
        exit 0
        ;;
    *)
        echo "Unknown command: $COMMAND"
        show_usage
        exit 1
        ;;
esac
