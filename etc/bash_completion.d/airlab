# Bash completion and shell function for the airlab command
# Installed to /etc/bash_completion.d/airlab

# Shell function wrapper for airlab.
# "cd" must run in the current shell (a subprocess cannot change the parent's
# working directory), so we intercept it here and forward everything else to
# the real /usr/local/bin/airlab binary.
airlab() {
    if [[ "${1:-}" == "cd" ]]; then
        shift
        local target="${AIRLAB_PATH:-}"
        if [[ -z "$target" ]]; then
            echo "Error: AIRLAB_PATH is not set. Run 'airlab setup local' first." >&2
            return 1
        fi
        if [[ "$1" == "--help" || "$1" == "-h" ]]; then
            echo "Usage: airlab cd [path]"
            echo ""
            echo "Change directory to a path relative to \$AIRLAB_PATH ($AIRLAB_PATH)."
            echo ""
            echo "  airlab cd              # cd to \$AIRLAB_PATH"
            echo "  airlab cd docker       # cd to \$AIRLAB_PATH/docker"
            echo "  airlab cd robot        # cd to \$AIRLAB_PATH/robot"
            return 0
        fi
        if [[ -n "$1" ]]; then
            target="$target/$1"
        fi
        builtin cd "$target"
    elif [[ "${1:-}" == "compose" ]]; then
        # Bare `airlab compose` prefills the command onto the prompt (must run in the
        # current shell — a subprocess can't inject into the parent's input buffer).
        # With arguments it is a normal command that RUNS Compose, so hand it straight
        # over: prefilling `airlab compose up -d` would be the wrong thing entirely.
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
            command airlab compose --help
            return 0
        fi
        if [[ $# -gt 0 ]]; then
            command airlab compose "$@"
            return $?
        fi
        local _cmd
        _cmd="$(command airlab compose --emit)" || return $?
        [[ -n "${AIRLAB_PATH:-}" ]] && builtin cd "${AIRLAB_PATH}/launch" 2>/dev/null
        if [[ $- == *i* ]]; then
            # Inject $_cmd into the readline buffer, editable (with completion): bind the
            # terminal's Device-Status-Report reply to type the command, then request a
            # report so the terminal replies and triggers the macro.
            bind '"\e[0n": "'"$_cmd"'"' 2>/dev/null
            printf '\e[5n'
        else
            printf '%s\n' "$_cmd"
        fi
    else
        command airlab "$@"
    fi
}

# Helper: read robot/system names from the target registry (robots.yaml).
_airlab_robot_names() {
    local robots_py="${AIRLAB_PATH:-}/robot/robots.py"
    [[ -f "$robots_py" ]] && python3 "$robots_py" list 2>/dev/null | sort -u
}

# Helper: list a system's network address names from robots.yaml (for `ssh --address=`).
_airlab_address_names() {
    local system="$1"
    local robots_py="${AIRLAB_PATH:-}/robot/robots.py"
    [[ -n "$system" && -f "$robots_py" ]] || return
    python3 "$robots_py" addresses "$system" 2>/dev/null
}

# Helper: generate robot names plus "local"
_airlab_targets() {
    echo "local"
    _airlab_robot_names
}

# Helper: list running Docker container names
_airlab_docker_containers() {
    docker ps --format '{{.Names}}' 2>/dev/null
}

# Helper: when "=" is in COMP_WORDBREAKS, bash splits "--opt=val" into
# separate tokens. Two cases arise:
#   Case A: "--path=val<TAB>" → words=[..., "--path", "=", "val"], prev="=", cur="val"
#   Case B: "--path=<TAB>"    → words=[..., "--path", "="],        prev="--path", cur="="
# This function returns the option name (e.g. "--path") for either case,
# or empty string if no "=" split is detected.
_airlab_get_eq_opt() {
    # Case A: typed something after "="
    if [[ "$prev" == "=" && $cword -ge 2 ]]; then
        echo "${words[$cword-2]}"
    # Case B: nothing after "=", cur is literally "="
    elif [[ "$cur" == "=" && "$prev" == --* ]]; then
        echo "$prev"
    fi
}

# Helper: complete relative paths (files and directories) under $AIRLAB_PATH.
# cur is the partial value typed so far (after the "=").
_airlab_complete_path_value() {
    local airlab_dir="${AIRLAB_PATH:-}"
    [[ -d "$airlab_dir" ]] || return

    local typed="$cur"

    local search_dir="$airlab_dir"
    if [[ "$typed" == */* ]]; then
        search_dir="$airlab_dir/${typed%/*}"
    fi

    [[ -d "$search_dir" ]] || return

    local entry rel_path
    while IFS= read -r -d '' entry; do
        rel_path="${entry#"$airlab_dir"/}"
        [[ "$rel_path" == "$typed"* ]] || continue

        if [[ -d "$entry" ]]; then
            COMPREPLY+=( "${rel_path}/" )
        else
            COMPREPLY+=( "${rel_path}" )
        fi
    done < <(find "$search_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)

    compopt -o nospace
}

# Helper: complete YAML files (.yaml/.yml) under $AIRLAB_PATH/version_control.
# Supports subdirectories. cur is the partial value typed so far (after the "=").
_airlab_complete_repo_file_value() {
    local vc_dir="${AIRLAB_PATH:-}/version_control"
    [[ -d "$vc_dir" ]] || return

    local typed="$cur"

    local search_dir="$vc_dir"
    if [[ "$typed" == */* ]]; then
        search_dir="$vc_dir/${typed%/*}"
    fi
    [[ -d "$search_dir" ]] || return

    local entry rel_path
    while IFS= read -r -d '' entry; do
        rel_path="${entry#"$vc_dir"/}"
        [[ "$rel_path" == "$typed"* ]] || continue

        if [[ -d "$entry" ]]; then
            COMPREPLY+=( "${rel_path}/" )
        elif [[ "$entry" == *.yaml || "$entry" == *.yml ]]; then
            COMPREPLY+=( "${rel_path}" )
        fi
    done < <(find "$search_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)

    compopt -o nospace
}

# Helper: complete alias names under $AIRLAB_ALIAS_PATH for "airlab a".
# Walks every colon-separated entry; offers sub-dirs (trailing /) and .sh/.py
# leaves with the extension stripped. cur is the partial alias path typed.
_airlab_complete_alias() {
    local raw="${AIRLAB_ALIAS_PATH:-${AIRLAB_PATH:-}/alias}"
    local -a bases
    IFS=':' read -r -a bases <<< "$raw"

    local typed="$cur"
    local base search_dir entry rel
    for base in "${bases[@]}"; do
        [[ -d "$base" ]] || continue
        search_dir="$base"
        if [[ "$typed" == */* ]]; then
            search_dir="$base/${typed%/*}"
        fi
        [[ -d "$search_dir" ]] || continue
        while IFS= read -r -d '' entry; do
            rel="${entry#"$base"/}"
            if [[ -d "$entry" ]]; then
                [[ "$rel" == "$typed"* ]] || continue
                COMPREPLY+=( "${rel}/" )
            elif [[ "$entry" == *.sh || "$entry" == *.py ]]; then
                rel="${rel%.*}"
                [[ "$rel" == "$typed"* ]] || continue
                COMPREPLY+=( "$rel" )
            fi
        done < <(find "$search_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)
    done

    compopt -o nospace
}

# Helper: complete directories under $AIRLAB_PATH for "airlab cd".
# Works like system cd — only shows directories, supports nested paths.
_airlab_complete_cd() {
    local airlab_dir="${AIRLAB_PATH:-}"
    [[ -d "$airlab_dir" ]] || return

    local typed="$cur"

    local search_dir="$airlab_dir"
    if [[ "$typed" == */* ]]; then
        search_dir="$airlab_dir/${typed%/*}"
    fi

    [[ -d "$search_dir" ]] || return

    local entry rel_path
    while IFS= read -r -d '' entry; do
        [[ -d "$entry" ]] || continue
        rel_path="${entry#"$airlab_dir"/}"
        [[ "$rel_path" == "$typed"* ]] || continue
        COMPREPLY+=( "${rel_path}/" )
    done < <(find "$search_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z)

    compopt -o nospace
}

_airlab_completions() {
    local cur prev words cword
    _init_completion || return

    # Detect "--opt=value" splitting caused by "=" in COMP_WORDBREAKS.
    #   Case A: "--path=doc<TAB>" → prev="=", cur="doc"
    #   Case B: "--path=<TAB>"    → prev="--path", cur="="
    # After this block, eq_opt holds the option name (e.g. "--path") and
    # cur holds the typed value (possibly empty) for both cases.
    local eq_opt
    eq_opt=$(_airlab_get_eq_opt)
    if [[ -n "$eq_opt" && "$cur" == "=" ]]; then
        # Case B: normalize cur to empty so helpers match everything
        cur=""
    fi

    # Top-level commands
    local commands="greet setup ssh exec auth ping sync launch env hosts set_hosts \
docker-build docker-up docker-join docker-list docker-clean ros2 vcs a cd compose upgrade --help --version"

    # Position 1: complete the sub-command
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return
    fi

    local cmd="${words[1]}"

    # --address=<TAB>: complete a system's address names for any command. The system
    # is the first positional (words[2]) everywhere except `env`, which carries a
    # subcommand in between, putting its system at words[3].
    if [[ "$eq_opt" == "--address" ]]; then
        local addr_system="${words[2]}"
        [[ "$cmd" == "env" || "$cmd" == "hosts" ]] && addr_system="${words[3]}"
        COMPREPLY=( $(compgen -W "$(_airlab_address_names "$addr_system")" -- "$cur") )
        return
    fi

    case "$cmd" in
        setup)
            # Position 2: target (local or robot name)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_targets) --help" -- "$cur") )
                return
            fi
            # Remaining positions: options
            if [[ "$cur" == --* ]]; then
                COMPREPLY=( $(compgen -W "--path= --address= --force --password --help" -- "$cur") )
            fi
            ;;

        ssh)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
            ;;

        exec)
            # Position 2: target robot/system name
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                return
            fi
            # After -c/--cli the rest is a free-form remote command — nothing to complete.
            local i
            for (( i=2; i < cword; i++ )); do
                [[ "${words[i]}" == "-c" || "${words[i]}" == "--cli" ]] && return
            done
            COMPREPLY=( $(compgen -W "--address= --cli -c --help" -- "$cur") )
            ;;

        auth)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--address= --help" -- "$cur") )
            ;;

        ping)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--address= --help" -- "$cur") )
            ;;

        sync)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                return
            fi
            # Complete paths under $AIRLAB_PATH for --path= and --exclude=
            if [[ "$eq_opt" == "--path" || "$eq_opt" == "--exclude" ]]; then
                _airlab_complete_path_value
                return
            fi
            COMPREPLY=( $(compgen -W "--dry-run --delete --path= --exclude= --time --progress --address= --password --help" -- "$cur") )
            ;;

        launch)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_targets) --help" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--yaml_file= --stop --address= --password --help" -- "$cur") )
            ;;

        env)
            # Position 2: the env sub-command
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "show compare sync-from sync-to set --help -h" -- "$cur") )
                return
            fi

            local env_cmd="${words[2]}"

            # Position 3: the target. `show` and `set` also act on this machine;
            # compare/sync-from/sync-to are inherently about a remote one.
            if [[ $cword -eq 3 ]]; then
                case "$env_cmd" in
                    show|set)
                        COMPREPLY=( $(compgen -W "$(_airlab_targets) --help" -- "$cur") )
                        ;;
                    compare|sync-from|sync-to)
                        COMPREPLY=( $(compgen -W "$(_airlab_robot_names) --help" -- "$cur") )
                        ;;
                esac
                return
            fi

            # Position 4+: flags (set takes VAR=value here, which we can't complete).
            case "$env_cmd" in
                show)
                    COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
                    ;;
                compare)
                    COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
                    ;;
                sync-from|sync-to)
                    COMPREPLY=( $(compgen -W "--address= --password --prune --dry-run -y --yes --help" -- "$cur") )
                    ;;
                set)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
                    fi
                    ;;
            esac
            ;;

        hosts)
            # Position 2: the hosts sub-command
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "set compare remove --help -h" -- "$cur") )
                return
            fi
            # Position 3: the target — all three act on local or a remote machine
            if [[ $cword -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_targets) --help" -- "$cur") )
                return
            fi
            # Position 4+: flags. compare never writes, so no --dry-run there.
            case "${words[2]}" in
                compare)
                    COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
                    ;;
                set|remove)
                    COMPREPLY=( $(compgen -W "--address= --password --dry-run --help" -- "$cur") )
                    ;;
            esac
            ;;

        compose)
            # Bare `airlab compose` prefills; with args it runs Compose, so offer the
            # subcommands. After the first one, Compose's own flags are too many and
            # too subcommand-specific to enumerate — leave them to the operator.
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "up down config ps logs build restart pull stop start images top --dry-run --help -h" -- "$cur") )
            fi
            ;;

        set_hosts)
            # Deprecated alias for `hosts set`; completed so old habits still work.
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_targets) --help" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--address= --password --help" -- "$cur") )
            ;;

        docker-build)
            COMPREPLY=( $(compgen -W "--system= --compose= --password --help" -- "$cur") )
            ;;

        docker-up)
            COMPREPLY=( $(compgen -W "--system= --compose= --password --help" -- "$cur") )
            ;;

        docker-join)
            if [[ "$eq_opt" == "--name" ]]; then
                COMPREPLY=( $(compgen -W "$(_airlab_docker_containers)" -- "$cur") )
                return
            fi
            COMPREPLY=( $(compgen -W "--system= --name= --password --help" -- "$cur") )
            ;;

        docker-list)
            COMPREPLY=( $(compgen -W "--system= --images --password --help" -- "$cur") )
            ;;

        docker-clean)
            COMPREPLY=( $(compgen -W "--system= --yes -y --password --help" -- "$cur") )
            ;;

        ros2)
            # Only complete wrapper flags when they appear at the very head
            # of the argument list (cword 2). After that, args are passed
            # through to ros2 inside the container — we don't introspect ros2
            # sub-commands from the host.
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "--image= --help" -- "$cur") )
            fi
            ;;

        cd)
            _airlab_complete_cd
            return
            ;;

        a)
            # Typing a flag → complete alias-level flags.
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--help --lint --new" -- "$cur") )
                return
            fi
            # Position 2 → complete alias names; deeper → just --help.
            if [[ $cword -eq 2 ]]; then
                _airlab_complete_alias
                return
            fi
            COMPREPLY=( $(compgen -W "--help" -- "$cur") )
            ;;

        vcs)
            local vcs_commands="init pull push status update check tag checkout --help"

            # Position 2: vcs sub-command
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$vcs_commands" -- "$cur") )
                return
            fi

            local vcs_cmd="${words[2]}"

            case "$vcs_cmd" in
                init)
                    if [[ "$eq_opt" == "--repo_file" ]]; then
                        _airlab_complete_repo_file_value
                        return
                    fi
                    COMPREPLY=( $(compgen -W "--repo_file= --path= --all --here --check --from-scratch --help" -- "$cur") )
                    ;;
                pull)
                    COMPREPLY=( $(compgen -W "--no-rebase --help" -- "$cur") )
                    ;;
                push)
                    COMPREPLY=( $(compgen -W "--tags= --force --dry-run --help" -- "$cur") )
                    ;;
                status)
                    COMPREPLY=( $(compgen -W "--show-branch --help" -- "$cur") )
                    ;;
                update)
                    COMPREPLY=( $(compgen -W "--help" -- "$cur") )
                    ;;
                check)
                    COMPREPLY=( $(compgen -W "--version-control --no-progress --help" -- "$cur") )
                    ;;
                tag)
                    # Tag name is a free-text positional; no completion source.
                    # After the tag name, complete option flags.
                    COMPREPLY=( $(compgen -W "--message= --lightweight --force --push --dry-run --no-progress --help" -- "$cur") )
                    ;;
                checkout)
                    # <ref> is a free-text positional; no completion source.
                    # After the ref, complete option flags.
                    COMPREPLY=( $(compgen -W "--no-fetch --force --no-progress --help" -- "$cur") )
                    ;;
            esac
            ;;
        upgrade)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--branch --yes --help" -- "$cur") )
            fi
            ;;
    esac

    # For options that end with '=', prevent bash from appending a space
    if [[ ${#COMPREPLY[@]} -eq 1 && "${COMPREPLY[0]}" == *= ]]; then
        compopt -o nospace
    fi
}

complete -F _airlab_completions airlab
